# Real résumé data. The repo is public; only samples/ holds committed fixtures,
# and those are synthetic. Anything else at the root is someone's actual CV.
/*_resume.json
/*-resume.json

# Claude Code personal settings. ".local." is per-machine by convention and it
# accumulates permission entries as you work, so it only ever creates diff noise.
.claude/settings.local.json
