<Project>

  <PropertyGroup>
    <!-- One target framework for every project. The test project used to sit on net10.0 while
         everything it tested shipped net8.0, so tests exercised a runtime the app never ran on. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Symbols travel inside the assembly instead of as sidecar .pdb files. Keeps a single-file
         publish actually single (project-reference .pdbs are copied to the publish dir otherwise)
         and means stack traces in bug reports keep their line numbers. -->
    <DebugType>embedded</DebugType>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <Version>1.2.1</Version>
    <Authors>Gentian Shkembi</Authors>
    <Product>ResumeBuilder</Product>
  </PropertyGroup>

</Project>
