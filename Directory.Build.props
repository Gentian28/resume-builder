<Project>

  <PropertyGroup>
    <!-- One target framework for every project. The test project used to sit on net10.0 while
         everything it tested shipped net8.0, so tests exercised a runtime the app never ran on. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <Version>1.0.0</Version>
    <Authors>Gentian Shkembi</Authors>
    <Product>ResumeBuilder</Product>
  </PropertyGroup>

</Project>
