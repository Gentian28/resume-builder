<Project>

  <PropertyGroup>
    <!-- Test and ship the same supported runtime. Pin its patch for self-contained packages. -->
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion Condition="'$(RuntimeIdentifier)' != ''">10.0.13</RuntimeFrameworkVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Symbols travel inside the assembly instead of as sidecar .pdb files. Keeps a single-file
         publish actually single (project-reference .pdbs are copied to the publish dir otherwise)
         and means stack traces in bug reports keep their line numbers. -->
    <DebugType>embedded</DebugType>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <Version>1.3.0</Version>
    <Authors>Gentian Shkembi</Authors>
    <Product>ResumeBuilder</Product>
  </PropertyGroup>

</Project>
