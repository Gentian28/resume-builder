<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="ResumeBuilder.App.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. Light and dark are peers
                  here: both are fully specced, so neither is a fallback for the other. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ResumeBuilder.App/Styles/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- Base theme. Supplies elevation, control themes and a type scale that would otherwise
             be hand-rolled on stock Fluent; Styles/Tokens.axaml layers over it. -->
        <semi:SemiTheme Locale="en-US" />
        <Style Selector="TextBlock.dimmed">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <!-- Persistent field labels. A watermark disappears the moment a field is filled, so a
             completed form became a column of values with nothing saying which was which. -->
        <Style Selector="TextBlock.fieldlabel">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource RbText2}"/>
        </Style>

        <!-- Section navigation entries. Flat by default so the list reads as navigation rather
             than a column of buttons; Semi's own hover and pressed states still apply. -->
        <Style Selector="Button.navitem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="{DynamicResource RbText2}"/>
        </Style>
        <Style Selector="Button.navitem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RbSurface2}"/>
        </Style>
        <Style Selector="Button.navitem.on /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RbSurface3}"/>
        </Style>
        <Style Selector="Button.navitem.on">
            <Setter Property="Foreground" Value="{DynamicResource RbText1}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBox.error">
            <Setter Property="BorderBrush" Value="{DynamicResource RbDanger}"/>
        </Style>
    </Application.Styles>
</Application>
