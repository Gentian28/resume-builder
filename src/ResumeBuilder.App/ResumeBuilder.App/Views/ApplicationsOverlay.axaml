<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ResumeBuilder.App.ViewModels"
             xmlns:conv="using:ResumeBuilder.App.Converters"
             xmlns:models="using:ResumeBuilder.Core.Models"
             x:Class="ResumeBuilder.App.Views.ApplicationsOverlay"
             x:DataType="vm:MainWindowViewModel">

    <Border Background="{DynamicResource RbBg}">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="26,22"
              MaxWidth="1040" HorizontalAlignment="Stretch">

            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Applications" FontSize="20" FontWeight="SemiBold"/>
                    <Button Grid.Column="1" Content="Done" Classes="accent"
                            Command="{Binding CloseApplicationsCommand}"/>
                </Grid>
                <!-- Leads with what is waiting on someone else, because that is the only part
                     the user can act on today. -->
                <TextBlock Text="{Binding ApplicationSummary}" FontSize="12"
                           Foreground="{DynamicResource RbText2}"
                           IsVisible="{Binding HasApplications}"/>
            </StackPanel>

            <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                <TextBox Width="230" Text="{Binding ApplicationSearch}" Watermark="Search company, role or contact" AutomationProperties.Name="Search applications" Margin="0,0,8,8"/>
                <ComboBox ItemsSource="{Binding ApplicationFilters}" SelectedItem="{Binding ApplicationFilter}" Width="150" AutomationProperties.Name="Filter applications" Margin="0,0,8,8"/>
                <Button Content="Export CSV" Command="{Binding ExportApplicationsCommand}" CommandParameter="csv" Margin="0,0,8,8"/>
                <Button Content="Export calendar" Command="{Binding ExportApplicationsCommand}" CommandParameter="calendar" Margin="0,0,8,8"/>
                <Button Content="Add draft" Command="{Binding AddDraftApplicationCommand}" Margin="0,0,8,8"/>
            </WrapPanel>
            <TextBlock Grid.Row="2" Text="No applications match this search or filter." IsVisible="{Binding !HasApplicationMatches}" VerticalAlignment="Top" Margin="0,12"/>
            <!-- Empty state explains what the thing is for, rather than saying "no items". -->
            <StackPanel Grid.Row="2" Spacing="9" VerticalAlignment="Center" HorizontalAlignment="Center"
                        MaxWidth="460" IsVisible="{Binding !HasApplications}">
                <TextBlock Text="Nothing tracked yet" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="12.5"
                           Foreground="{DynamicResource RbText2}"
                           Text="Track an application and this remembers which résumé you sent, when, and what happened, so when they call weeks later you know exactly what they read."/>
                <Button Content="Track the résumé I have open" HorizontalAlignment="Center"
                        Classes="accent" Margin="0,6,0,0"
                        Command="{Binding TrackCurrentResumeCommand}"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" Margin="0,14,0,0" IsVisible="{Binding HasApplications}">
                <ItemsControl ItemsSource="{Binding FilteredApplications}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:JobApplicationViewModel">
                            <Border Background="{DynamicResource RbSurface1}" CornerRadius="8"
                                    Padding="14,12" Margin="0,0,0,8">
                                <StackPanel Spacing="9">

                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                        <StackPanel Spacing="3">
                                            <TextBox Text="{Binding Company}" Watermark="Company"
                                                     FontSize="14" FontWeight="SemiBold"
                                                     AutomationProperties.Name="Company"/>
                                            <TextBox Text="{Binding Role}" Watermark="Role"
                                                     FontSize="12"
                                                     AutomationProperties.Name="Role"/>
                                        </StackPanel>

                                        <ComboBox Grid.Column="1" MinWidth="130" Margin="10,0,0,0"
                                                  VerticalAlignment="Top"
                                                  ItemsSource="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ApplicationStatuses}"
                                                  SelectedItem="{Binding Status}"
                                                  AutomationProperties.Name="Status"/>

                                        <!-- The whole point: open the exact résumé this company
                                             received. Hidden when the row was never linked to one. -->
                                        <TextBlock Grid.Column="2" Text="Not linked to a résumé"
                                                   FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource RbText3}"
                                                   IsVisible="{Binding !HasResume}"/>

                                        <Button Grid.Column="2" Content="Open résumé" Margin="6,0,0,0"
                                                VerticalAlignment="Top"
                                                IsVisible="{Binding HasResume}"
                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).OpenApplicationResumeCommand}"
                                                CommandParameter="{Binding}"/>

                                        <Button Classes="icon" Grid.Column="3"
                                                Margin="8,0,0,0" VerticalAlignment="Top"
                                                ToolTip.Tip="Stop tracking"
                                                AutomationProperties.Name="Stop tracking"
                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DeleteApplicationCommand}"
                                                CommandParameter="{Binding}"><PathIcon Data="{StaticResource IconClose}"/></Button>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Text="{Binding Age}" FontSize="11.5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource RbText2}"/>
                                        <!-- Only shown when it is actually waiting on them and has
                                             been a while: a nudge, not a decoration. -->
                                        <Border Grid.Column="1" HorizontalAlignment="Left" Margin="9,0,0,0"
                                                Background="{DynamicResource RbWarningBg}"
                                                BorderBrush="{DynamicResource RbWarningBorder}"
                                                BorderThickness="1" CornerRadius="10" Padding="7,1"
                                                IsVisible="{Binding IsStale}">
                                            <TextBlock Text="worth chasing" FontSize="10.5"
                                                       Foreground="{DynamicResource RbWarning}"/>
                                        </Border>
                                    </Grid>

                                    <WrapPanel>
                                        <StackPanel Margin="0,0,12,8"><TextBlock Text="Applied date" FontSize="11"/><DatePicker SelectedDate="{Binding AppliedDate}" AutomationProperties.Name="Applied date"/></StackPanel>
                                        <StackPanel Margin="0,0,12,8"><TextBlock Text="Next action" FontSize="11"/><DatePicker SelectedDate="{Binding NextActionDate}" AutomationProperties.Name="Next action date"/></StackPanel>
                                        <Button Content="Clear next action" Command="{Binding ClearNextActionCommand}" Margin="0,0,8,8"/>
                                        <TextBlock Text="Follow-up due" IsVisible="{Binding IsFollowUpDue}" Foreground="{DynamicResource RbWarning}" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                    <TextBlock Text="Choose a letter while Saved, then change status to capture what you send." FontSize="11" TextWrapping="Wrap"/>
                                    <TextBox Text="{Binding Contact}" Watermark="Contact name or details" AutomationProperties.Name="Contact"/>
                                    <TextBox Text="{Binding Link}" Watermark="Posting URL" AutomationProperties.Name="Posting URL"/>
                                    <WrapPanel>
                                        <ComboBox Width="250" IsEnabled="{Binding CanEditLetterLink}" ItemsSource="{Binding LetterChoices}" SelectedItem="{Binding SelectedCoverLetter}" AutomationProperties.Name="Linked cover letter">
                                            <ComboBox.ItemTemplate><DataTemplate x:DataType="models:CoverLetter"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Content="Save sent PDF" IsVisible="{Binding HasSentResumePdf}" Margin="8,0" Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ExportSentResumeCommand}" CommandParameter="{Binding}"/>
                                        <Button Content="Save sent letter PDF" IsVisible="{Binding HasSentLetterPdf}" Margin="8,0" Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ExportSentLetterCommand}" CommandParameter="{Binding}"/>
                                        <Button Content="Open letter" IsVisible="{Binding HasLetter}" Margin="8,0" Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).OpenApplicationLetterCommand}" CommandParameter="{Binding}"/>
                                    </WrapPanel>
                                    <TextBox Text="{Binding Notes}" Watermark="Notes: who you spoke to, what they asked"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="42"
                                             FontSize="12" AutomationProperties.Name="Notes"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Grid.Row="3" Content="+ Track the résumé I have open" Margin="0,12,0,0"
                    HorizontalAlignment="Left" IsVisible="{Binding HasApplications}"
                    Command="{Binding TrackCurrentResumeCommand}"/>
        </Grid>
    </Border>

</UserControl>
