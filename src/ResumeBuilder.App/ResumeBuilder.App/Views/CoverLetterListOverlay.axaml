<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ResumeBuilder.App.ViewModels"
             xmlns:conv="using:ResumeBuilder.App.Converters"
             xmlns:models="using:ResumeBuilder.Core.Models"
             x:Class="ResumeBuilder.App.Views.CoverLetterListOverlay"
             x:DataType="vm:MainWindowViewModel">

        <Border Background="#80000000">
            <Border Background="{DynamicResource RbSurface1}"
                    CornerRadius="12" Margin="100" Padding="20" MaxWidth="600">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" Text="Your Cover Letters" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                    <ScrollViewer Grid.Row="1">
                        <StackPanel>
                            <TextBlock Text="No cover letters yet - create one from the current resume."
                                       FontSize="12" Opacity="0.6"
                                       IsVisible="{Binding !CoverLetters.Count}"/>
                            <ItemsControl ItemsSource="{Binding CoverLetters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:CoverLetter">
                                        <Border Background="{DynamicResource RbSurface2}"
                                                CornerRadius="8" Padding="15" Margin="0,5">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="3">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding CompanyName}" FontSize="12" Opacity="0.7"
                                                               IsVisible="{Binding CompanyName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    <TextBlock Text="{Binding UpdatedAt, StringFormat='Last updated: {0:g}'}"
                                                               FontSize="11" Opacity="0.5"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                                    <Button Content="Open"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).LoadCoverLetterCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Delete"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DeleteCoverLetterCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" Spacing="10">
                        <Button Content="New Cover Letter" Command="{Binding NewCoverLetterCommand}"/>
                        <Button Content="Cancel" Command="{Binding CloseCoverLetterListCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

</UserControl>
