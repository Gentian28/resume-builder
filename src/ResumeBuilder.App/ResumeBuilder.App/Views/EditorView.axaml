<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ResumeBuilder.App.ViewModels"
             xmlns:conv="using:ResumeBuilder.App.Converters"
             xmlns:models="using:ResumeBuilder.Core.Models"
             x:Class="ResumeBuilder.App.Views.EditorView"
             x:DataType="vm:MainWindowViewModel">

            <Border Background="{DynamicResource RbBg}"
                    BorderBrush="{DynamicResource RbBorder}" BorderThickness="0,0,1,0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15" Spacing="15">

                        <!-- AI Assistant Panel -->
                        <Border Background="{DynamicResource RbSurface1}"
                                CornerRadius="8" Padding="15" IsVisible="{Binding ShowAiPanel}">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Text="AI Assistant" FontWeight="SemiBold" FontSize="14"/>
                                    <Border Grid.Column="1" Background="#3316a34a" CornerRadius="8"
                                            Padding="6,1" Margin="8,0,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            IsVisible="{Binding IsAiLocal}">
                                        <TextBlock Text="Local" FontSize="10"/>
                                    </Border>
                                    <Button Grid.Column="2" Content="X" Padding="4,0"
                                            Command="{Binding ToggleAiPanelCommand}"/>
                                </Grid>

                                <!-- Endpoint Configuration -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Endpoint" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="Any OpenAI-compatible server works: OpenAI itself, or a local LLM such as Ollama or LM Studio."
                                               FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Button Content="Use OpenAI" Padding="8,3" FontSize="11"
                                                Command="{Binding UseOpenAiEndpointCommand}"/>
                                        <Button Content="Use local LLM" Padding="8,3" FontSize="11"
                                                Command="{Binding UseLocalAiEndpointCommand}"/>
                                    </StackPanel>
                                    <TextBox Watermark="Base URL (e.g. https://api.openai.com/v1)"
                                             Text="{Binding AiBaseUrl}" AutomationProperties.Name="Base URL"/>
                                    <TextBox Watermark="Model (e.g. gpt-4o-mini, llama3)"
                                             Text="{Binding AiModel}" AutomationProperties.Name="Model"/>
                                    <TextBox Watermark="API key (not needed for a local endpoint)"
                                             Text="{Binding AiApiKey}"
                                             PasswordChar="*" AutomationProperties.Name="API key"/>
                                    <Button Content="Apply endpoint settings"
                                            Command="{Binding ApplyAiSettingsCommand}"
                                            HorizontalAlignment="Left"/>
                                    <Border Background="{DynamicResource RbSurface2}"
                                            CornerRadius="4" Padding="8">
                                        <TextBlock Text="{Binding AiPrivacyNotice}"
                                                   FontSize="11" Opacity="0.85" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>

                                <!-- AI Features (when configured) -->
                                <StackPanel Spacing="10" IsVisible="{Binding IsAiConfigured}">
                                    <TextBlock Text="{Binding AiStatusMessage}"
                                               FontSize="11" Opacity="0.7"
                                               IsVisible="{Binding AiStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                    <!-- Generate Summary -->
                                    <Border Background="{DynamicResource RbSurface2}"
                                            CornerRadius="4" Padding="10">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Summary Generator" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="Generate a professional summary based on your experience and skills."
                                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                                            <Button Content="Generate Summary"
                                                    Command="{Binding GenerateAiSummaryCommand}"
                                                    IsEnabled="{Binding !IsAiProcessing}"
                                                    HorizontalAlignment="Left"/>
                                            <TextBox Text="{Binding AiGeneratedSummary}"
                                                     IsReadOnly="True"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     MinHeight="60"
                                                     IsVisible="{Binding AiGeneratedSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            <Button Content="Apply to Summary"
                                                    Command="{Binding ApplyAiSummaryCommand}"
                                                    IsVisible="{Binding AiGeneratedSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                    HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Skill Suggestions -->
                                    <Border Background="{DynamicResource RbSurface2}"
                                            CornerRadius="4" Padding="10">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Skill Suggestions" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="Get AI-suggested skills based on your job title and experience."
                                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                                            <Button Content="Suggest Skills"
                                                    Command="{Binding SuggestAiSkillsCommand}"
                                                    IsEnabled="{Binding !IsAiProcessing}"
                                                    HorizontalAlignment="Left"/>
                                            <ItemsControl ItemsSource="{Binding AiSkillSuggestions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource RbSurface3}"
                                                                CornerRadius="4" Padding="6,4" Margin="0,2">
                                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                                <Button Grid.Column="1" Content="+" Width="24" Height="24"
                                                                        Margin="5,0" Padding="0"
                                                                        ToolTip.Tip="Add this skill"
                                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).AddSuggestedSkillCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                                <Button Grid.Column="2" Content="X" Width="24" Height="24"
                                                                        Padding="0"
                                                                        ToolTip.Tip="Dismiss"
                                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DismissSuggestedSkillCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Processing Indicator -->
                                    <ProgressBar IsIndeterminate="True"
                                                 IsVisible="{Binding IsAiProcessing}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Tailor to Job Panel -->
                        <Border Background="{DynamicResource RbSurface1}"
                                CornerRadius="8" Padding="15" IsVisible="{Binding ShowTailorPanel}">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Tailor to Job" FontWeight="SemiBold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="X" Padding="4,0"
                                            Command="{Binding ToggleTailorPanelCommand}"/>
                                </Grid>

                                <TextBlock Text="Paste the job description. You get a keyword match, and - when AI is configured - proposed rewrites you can accept one by one."
                                           FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>

                                <TextBox Text="{Binding TargetRoleText}"
                                         Watermark="Target role (e.g. Senior Backend Engineer)" AutomationProperties.Name="Target role"/>

                                <TextBox Text="{Binding JobDescriptionText}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Watermark="Paste job description here..."
                                         MinHeight="100"
                                         MaxHeight="150" AutomationProperties.Name="Paste job description here"/>

                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Button Content="Tailor"
                                            Command="{Binding TailorToJobCommand}"
                                            IsEnabled="{Binding !IsTailoring}"/>
                                    <Button Content="Save as variant for this job"
                                            Command="{Binding SaveAsVariantCommand}"
                                            ToolTip.Tip="Branches this resume into a variant tailored for this posting"/>
                                </StackPanel>

                                <ProgressBar IsIndeterminate="True" Height="4"
                                             IsVisible="{Binding IsTailoring}"/>

                                <!-- AI status (never blocks the keyword analysis below) -->
                                <Border Background="#33FFA500" CornerRadius="4" Padding="8"
                                        IsVisible="{Binding TailorAiError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{Binding TailorAiError}"
                                               FontSize="11" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Proposed rewrites -->
                                <StackPanel Spacing="8" IsVisible="{Binding HasTailoredEdits}">
                                    <TextBlock Text="Proposed rewrites" FontWeight="SemiBold" FontSize="12"/>
                                    <ItemsControl ItemsSource="{Binding TailoredEdits}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TailoredEditViewModel">
                                                <Border Background="{DynamicResource RbSurface2}"
                                                        CornerRadius="4" Padding="10" Margin="0,3">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnDefinitions="Auto,*">
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding Accepted}"
                                                                      VerticalAlignment="Center"
                                                                      ToolTip.Tip="Accept this rewrite"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding TargetDescription}"
                                                                       FontWeight="SemiBold" FontSize="12"
                                                                       TextWrapping="Wrap"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*,8,*">
                                                            <StackPanel Grid.Column="0" Spacing="2">
                                                                <TextBlock Text="Original" FontSize="10" Opacity="0.6"/>
                                                                <TextBlock Text="{Binding Original}" FontSize="11"
                                                                           TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Spacing="2">
                                                                <TextBlock Text="Proposed" FontSize="10" Opacity="0.6"/>
                                                                <TextBlock Text="{Binding Proposed}" FontSize="11"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource RbAccent}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Rationale}" FontSize="10"
                                                                   Opacity="0.7" TextWrapping="Wrap"
                                                                   IsVisible="{Binding Rationale, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Apply accepted"
                                            Command="{Binding ApplyAcceptedEditsCommand}"
                                            ToolTip.Tip="Applies the ticked rewrites; Ctrl+Z reverts them"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>

                                <!-- Results (when available) -->
                                <StackPanel Spacing="10" IsVisible="{Binding HasKeywordAnalysis}">
                                    <!-- Score -->
                                    <Border Background="{DynamicResource RbSurface2}"
                                            CornerRadius="4" Padding="10">
                                        <StackPanel Spacing="5">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Match Score" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding KeywordMatchScore, StringFormat={}{0}%}"
                                                           FontWeight="Bold" FontSize="18"/>
                                            </Grid>
                                            <ProgressBar Value="{Binding KeywordMatchScore}"
                                                         Maximum="100"
                                                         Height="8"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Missing Keywords -->
                                    <Expander Header="Missing Keywords" IsExpanded="True"
                                              IsVisible="{Binding MissingKeywords.Count}">
                                        <StackPanel Spacing="4" Margin="0,5,0,0">
                                            <TextBlock Text="Add these to improve your match:"
                                                       FontSize="11" Opacity="0.7"/>
                                            <ItemsControl ItemsSource="{Binding MissingKeywords}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding}"
                                                                Margin="0,0,4,4"
                                                                Padding="8,4"
                                                                FontSize="11"
                                                                ToolTip.Tip="Click to add as skill"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).AddMissingKeywordAsSkillCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Matched Keywords -->
                                    <Expander Header="Matched Keywords">
                                        <ItemsControl ItemsSource="{Binding MatchedKeywords}" Margin="0,5,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                        <TextBlock Text="{Binding Keyword}" FontSize="11"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding ResumeCount, StringFormat='({0}x)'}"
                                                                   FontSize="11" Opacity="0.6"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>

                                    <!-- Suggestions -->
                                    <Expander Header="Suggestions" IsExpanded="True"
                                              IsVisible="{Binding KeywordSuggestions.Count}">
                                        <ItemsControl ItemsSource="{Binding KeywordSuggestions}" Margin="0,5,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>

                                    <!-- Warnings -->
                                    <Expander Header="Warnings"
                                              IsVisible="{Binding KeywordWarnings.Count}">
                                        <ItemsControl ItemsSource="{Binding KeywordWarnings}" Margin="0,5,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="11"
                                                               Foreground="Orange"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>

                                    <!-- Suggested Skills -->
                                    <Expander Header="Suggested Skills"
                                              IsVisible="{Binding TailorSuggestedSkills.Count}">
                                        <StackPanel Spacing="4" Margin="0,5,0,0">
                                            <TextBlock Text="Click to add as a skill:" FontSize="11" Opacity="0.7"/>
                                            <ItemsControl ItemsSource="{Binding TailorSuggestedSkills}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding}"
                                                                Margin="0,0,4,4" Padding="8,4" FontSize="11"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).AddMissingKeywordAsSkillCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>

                                    <Button Content="Clear Analysis"
                                            Command="{Binding ClearTailoringCommand}"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Sync Panel -->
                        <Border Background="{DynamicResource RbSurface1}"
                                CornerRadius="8" Padding="15" IsVisible="{Binding ShowSyncPanel}">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Sync Settings" FontWeight="SemiBold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="X" Padding="4,0"
                                            Command="{Binding ToggleSyncPanelCommand}"/>
                                </Grid>

                                <TextBlock Text="Two-way sync with a local folder (which can itself be a cloud-synced folder like Dropbox, OneDrive, or Google Drive). Newer changes are copied in both directions."
                                           FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>

                                <!-- Configuration -->
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Sync Folder:" FontSize="12"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Text="{Binding SyncFolderPath}"
                                                 Watermark="C:\Users\...\ResumeBackups" AutomationProperties.Name="C:\Users\...\ResumeBackups"/>
                                        <Button Grid.Column="1" Content="Browse..."
                                                Command="{Binding BrowseSyncFolderCommand}"
                                                Margin="5,0,0,0"/>
                                    </Grid>
                                    <TextBlock Text="When both sides changed:" FontSize="12" Margin="0,5,0,0"/>
                                    <ComboBox ItemsSource="{Binding ConflictResolutions}"
                                              SelectedItem="{Binding SelectedConflictResolution}"
                                              HorizontalAlignment="Stretch"/>
                                    <Button Content="Configure Sync"
                                            Command="{Binding ConfigureSyncCommand}"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>

                                <!-- Status -->
                                <Border Background="{DynamicResource RbSurface2}"
                                        CornerRadius="4" Padding="10">
                                    <StackPanel Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Status:" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SyncStatusText}"
                                                       Opacity="0.8" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" IsVisible="{Binding HasSyncResult}">
                                            <TextBlock Text="{Binding SyncUploadedCount, StringFormat='Uploaded: {0}'}"
                                                       FontSize="11" Opacity="0.8"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SyncDownloadedCount, StringFormat='Downloaded: {0}'}"
                                                       FontSize="11" Opacity="0.8"/>
                                        </Grid>
                                        <ProgressBar IsIndeterminate="True"
                                                     IsVisible="{Binding IsSyncing}"
                                                     Height="4"/>
                                    </StackPanel>
                                </Border>

                                <!-- Conflicts -->
                                <Border Background="#33FFA500" CornerRadius="4" Padding="10"
                                        IsVisible="{Binding SyncConflicts.Count}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Conflicts" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="These resumes changed on both sides. The losing version was kept next to the winner as a .conflict.json file in the sync folder."
                                                   FontSize="11" Opacity="0.8" TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{Binding SyncConflicts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SyncConflictViewModel">
                                                    <StackPanel Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding ResumeName}" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.7"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Sync Actions (when configured) -->
                                <StackPanel Spacing="10" IsVisible="{Binding IsSyncConfigured}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Button Content="Sync All"
                                                Command="{Binding SyncAllCommand}"
                                                IsEnabled="{Binding !IsSyncing}"/>
                                        <Button Content="Sync Current"
                                                Command="{Binding SyncCurrentResumeCommand}"
                                                IsEnabled="{Binding !IsSyncing}"/>
                                        <Button Content="Refresh"
                                                Command="{Binding RefreshRemoteResumesCommand}"
                                                IsEnabled="{Binding !IsSyncing}"/>
                                    </StackPanel>

                                    <!-- Remote Files -->
                                    <Expander Header="Remote Resumes" IsExpanded="True">
                                        <StackPanel Spacing="4" Margin="0,5,0,0">
                                            <TextBlock Text="Click to import a remote resume:"
                                                       FontSize="11" Opacity="0.7"
                                                       IsVisible="{Binding RemoteResumes.Count}"/>
                                            <TextBlock Text="No resumes found in sync folder"
                                                       FontSize="11" Opacity="0.5"
                                                       IsVisible="{Binding !RemoteResumes.Count}"/>
                                            <ItemsControl ItemsSource="{Binding RemoteResumes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Margin="0,2" Padding="8,6"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Left"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ImportRemoteResumeCommand}"
                                                                CommandParameter="{Binding Path}">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="12"/>
                                                                    <TextBlock Text="{Binding LastModifiedDisplay}"
                                                                               FontSize="10" Opacity="0.6"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding SizeDisplay}"
                                                                           FontSize="10" Opacity="0.6"
                                                                           VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Resume Name -->
                        <Border Background="{DynamicResource RbSurface1}"
                                IsVisible="{Binding SelectedEditorSection, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=name}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Resume Name" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SaveStateText}"
                                               FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBox Watermark="Untitled Resume" Text="{Binding ResumeName}" AutomationProperties.Name="Untitled Resume"/>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Button Content="Save" Command="{Binding SaveCurrentResumeCommand}"/>
                                    <Button Content="Save As..." Command="{Binding SaveAsCommand}"/>
                                    <Button Content="Open..." Command="{Binding OpenResumeListCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Template Selector -->
                        <Border Background="{DynamicResource RbSurface1}"
                                IsVisible="{Binding SelectedEditorSection, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=template}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Template" FontWeight="SemiBold" FontSize="14"/>
                                <Button Content="{Binding SelectedTemplate.Name, FallbackValue='Select Template'}"
                                        Command="{Binding OpenTemplateGalleryCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- Template Customization -->
                        <Border Background="{DynamicResource RbSurface1}"
                                IsVisible="{Binding SelectedEditorSection, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=appearance}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Customize Appearance" FontWeight="SemiBold" FontSize="14"/>
                                    <ToggleButton Grid.Column="1" Content="..."
                                                  IsChecked="{Binding ShowCustomizationPanel}"
                                                  Padding="8,2"/>
                                </Grid>

                                <StackPanel Spacing="10" IsVisible="{Binding ShowCustomizationPanel}">
                                    <!-- Accent Color -->
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Accent Color" FontSize="12" Opacity="0.8"/>
                                        <ItemsControl ItemsSource="{Binding PresetColors}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Button Width="24" Height="24" Margin="2"
                                                            Padding="0"
                                                            CornerRadius="4"
                                                            Background="{Binding Converter={x:Static vm:MainWindowViewModel.HexToColorConverter}}"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SetAccentColorCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Color Picker Button and Hex Input -->
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Button Grid.Column="0"
                                                    Width="30" Height="30"
                                                    Padding="0" Margin="0,0,5,0"
                                                    ToolTip.Tip="Open color picker"
                                                    Background="Transparent"
                                                    Command="{Binding ToggleAccentColorPickerCommand}">
                                                <Border Width="28" Height="28" CornerRadius="4"
                                                        BorderBrush="{DynamicResource RbBorder}"
                                                        BorderThickness="1"
                                                        Background="{Binding AccentColor, Converter={x:Static vm:MainWindowViewModel.HexToColorConverter}}"/>
                                            </Button>
                                            <TextBox Grid.Column="1"
                                                     Watermark="Hex color (e.g., #2563eb)"
                                                     Text="{Binding AccentColor, Mode=TwoWay}"
                                                     MaxLength="7" AutomationProperties.Name="Hex color"/>
                                        </Grid>
                                        <!-- Inline Color Picker (shown when toggled) -->
                                        <ColorView IsVisible="{Binding ShowAccentColorPicker}"
                                                   Color="{Binding AccentColorValue, Mode=TwoWay}"
                                                   ColorSpectrumShape="Ring"
                                                   IsAlphaVisible="False"
                                                   IsColorSpectrumSliderVisible="True"
                                                   IsComponentSliderVisible="False"
                                                   IsHexInputVisible="False"
                                                   Margin="0,5,0,0"
                                                   HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <!-- Font Family -->
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Body Font" FontSize="12" Opacity="0.8"/>
                                        <ComboBox ItemsSource="{Binding AvailableFonts}"
                                                  SelectedItem="{Binding SelectedFontFamily}"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Heading Font" FontSize="12" Opacity="0.8"/>
                                        <ComboBox ItemsSource="{Binding AvailableFonts}"
                                                  SelectedItem="{Binding SelectedHeadingFontFamily}"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <!-- Font Size Scale -->
                                    <StackPanel Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Font Size" FontSize="12" Opacity="0.8"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FontSizeScale, StringFormat={}{0:P0}}"
                                                       FontSize="12" Opacity="0.8"/>
                                        </Grid>
                                        <Slider Minimum="0.8" Maximum="1.3"
                                                Value="{Binding FontSizeScale}"
                                                TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                    </StackPanel>

                                    <!-- Line Spacing -->
                                    <StackPanel Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Line Spacing" FontSize="12" Opacity="0.8"/>
                                            <TextBlock Grid.Column="1" Text="{Binding LineSpacing, StringFormat={}{0:F1}}"
                                                       FontSize="12" Opacity="0.8"/>
                                        </Grid>
                                        <Slider Minimum="1.0" Maximum="2.0"
                                                Value="{Binding LineSpacing}"
                                                TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                                    </StackPanel>

                                    <!-- Page Margin -->
                                    <StackPanel Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Page Margin" FontSize="12" Opacity="0.8"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PageMargin, StringFormat={}{0:F0}px}"
                                                       FontSize="12" Opacity="0.8"/>
                                        </Grid>
                                        <Slider Minimum="15" Maximum="50"
                                                Value="{Binding PageMargin}"
                                                TickFrequency="5" IsSnapToTickEnabled="True"/>
                                    </StackPanel>

                                    <!-- Section Spacing -->
                                    <StackPanel Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Section Spacing" FontSize="12" Opacity="0.8"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SectionSpacing, StringFormat={}{0:F0}px}"
                                                       FontSize="12" Opacity="0.8"/>
                                        </Grid>
                                        <Slider Minimum="5" Maximum="30"
                                                Value="{Binding SectionSpacing}"
                                                TickFrequency="5" IsSnapToTickEnabled="True"/>
                                    </StackPanel>

                                    <!-- Reset Button -->
                                    <Button Content="Reset to Defaults"
                                            Command="{Binding ResetCustomizationCommand}"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Section Ordering -->
                        <Border Background="{DynamicResource RbSurface1}"
                                IsVisible="{Binding SelectedEditorSection, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=order}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Section Order" FontWeight="SemiBold" FontSize="14"/>
                                    <ToggleButton Grid.Column="1" Content="..."
                                                  IsChecked="{Binding ShowSectionOrderPanel}"
                                                  Padding="8,2"/>
                                </Grid>

                                <StackPanel Spacing="5" IsVisible="{Binding ShowSectionOrderPanel}">
                                    <TextBlock Text="Use the arrows to reorder sections; untick one to hide it"
                                               FontSize="11" Opacity="0.6" Margin="0,0,0,5"/>
                                    <ItemsControl ItemsSource="{Binding Sections}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SectionViewModel">
                                                <Border Background="{DynamicResource RbSurface2}"
                                                        CornerRadius="4" Padding="8" Margin="0,2">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible}"
                                                                  VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                                   VerticalAlignment="Center" Margin="8,0"
                                                                   Classes.dimmed="{Binding !IsVisible}"/>
                                                        <Button Grid.Column="2" Content="^" Width="28" Height="28"
                                                                Padding="0" Margin="2,0"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveSectionUpCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="3" Content="v" Width="28" Height="28"
                                                                Padding="0"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveSectionDownCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Reset Order"
                                            Command="{Binding ResetSectionOrderCommand}"
                                            HorizontalAlignment="Left" Margin="0,5,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Personal Information -->
                        <Border Background="{DynamicResource RbSurface1}"
                                IsVisible="{Binding SelectedEditorSection, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=personal}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Personal Information" FontWeight="SemiBold" FontSize="14"/>

                                <!-- Photo Upload -->
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Grid.Column="0" Width="80" Height="80" CornerRadius="40"
                                            Background="{DynamicResource RbSurface2}"
                                            ClipToBounds="True" Margin="0,0,15,0">
                                        <Panel>
                                            <TextBlock Text="Photo" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource RbText3}"
                                                       IsVisible="{Binding !HasPhoto}"/>
                                            <Image Source="{Binding PhotoPreview}" Stretch="UniformToFill"
                                                   IsVisible="{Binding HasPhoto}"/>
                                        </Panel>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                        <Button Content="Upload Photo" Command="{Binding UploadPhotoCommand}"
                                                HorizontalAlignment="Left"/>
                                        <Button Content="Remove" Command="{Binding RemovePhotoCommand}"
                                                IsVisible="{Binding HasPhoto}"
                                                HorizontalAlignment="Left" Padding="10,5"/>
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,10,*">
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock Classes="fieldlabel" Text="First name"/>
                                        <TextBox Text="{Binding FirstName}" AutomationProperties.Name="First name"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="3">
                                        <TextBlock Classes="fieldlabel" Text="Last name"/>
                                        <TextBox Text="{Binding LastName}" AutomationProperties.Name="Last name"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="fieldlabel" Text="Job title"/>
                                    <TextBox Text="{Binding JobTitle}" AutomationProperties.Name="Job title"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,10,*" RowDefinitions="Auto,Auto">
                                    <StackPanel Grid.Column="0" Grid.Row="0" Spacing="3">
                                        <TextBlock Classes="fieldlabel" Text="Email"/>
                                        <TextBox Text="{Binding Email}"
                                                 Classes.error="{Binding EmailError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="Email"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="{Binding EmailError}"
                                               Foreground="Red" FontSize="11" Margin="0,2,0,0"
                                               IsVisible="{Binding EmailError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <StackPanel Grid.Column="2" Grid.Row="0" Spacing="3">
                                        <TextBlock Classes="fieldlabel" Text="Phone"/>
                                        <TextBox Text="{Binding Phone}"
                                                 Classes.error="{Binding PhoneError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="Phone"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding PhoneError}"
                                               Foreground="Red" FontSize="11" Margin="0,2,0,0"
                                               IsVisible="{Binding PhoneError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,10,*">
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock Classes="fieldlabel" Text="City"/>
                                        <TextBox Text="{Binding City}" AutomationProperties.Name="City"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="3">
                                        <TextBlock Classes="fieldlabel" Text="Country"/>
                                        <TextBox Text="{Binding Country}" AutomationProperties.Name="Country"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="fieldlabel" Text="Website"/>
                                    <TextBox Text="{Binding Website}"
                                             Classes.error="{Binding WebsiteError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="Website"/>
                                    <TextBlock Text="{Binding WebsiteError}"
                                               Foreground="Red" FontSize="11"
                                               IsVisible="{Binding WebsiteError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="fieldlabel" Text="LinkedIn URL"/>
                                    <TextBox Text="{Binding LinkedIn}"
                                             Classes.error="{Binding LinkedInError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="LinkedIn URL"/>
                                    <TextBlock Text="{Binding LinkedInError}"
                                               Foreground="Red" FontSize="11"
                                               IsVisible="{Binding LinkedInError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                                <TextBlock Classes="fieldlabel" Text="GitHub Username"/>
                                    <TextBox Text="{Binding GitHub}" AutomationProperties.Name="GitHub Username"/>
                            </StackPanel>
                        </Border>

                        <!-- Professional Summary -->
                        <Border Background="{DynamicResource RbSurface1}"
                                IsVisible="{Binding SelectedEditorSection, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=summary}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Professional Summary" FontWeight="SemiBold" FontSize="14"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                        <Border Background="#FFA500" CornerRadius="10" Padding="6,2"
                                                IsVisible="{Binding SummarySpellErrorCount}"
                                                Cursor="Hand">
                                            <Border.Styles>
                                                <Style Selector="Border:pointerover">
                                                    <Setter Property="Opacity" Value="0.8"/>
                                                </Style>
                                            </Border.Styles>
                                            <TextBlock Foreground="White" FontSize="11">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} spelling issue(s)">
                                                        <Binding Path="SummarySpellErrorCount"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>
                                        <Button Content="Check" Padding="8,2"
                                                Command="{Binding ShowSpellingSuggestionsCommand}"
                                                IsVisible="{Binding SummarySpellErrorCount}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBox Watermark="Write a brief summary of your professional background..."
                                         Text="{Binding Summary}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="100" AutomationProperties.Name="Write a brief summary of your professional background"/>

                                <!-- Spell Check Suggestions Popup -->
                                <Border Background="{DynamicResource RbSurface3}"
                                        CornerRadius="4" Padding="10"
                                        IsVisible="{Binding ShowSpellSuggestions}">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Spelling Suggestions" FontWeight="SemiBold"/>
                                            <Button Grid.Column="1" Content="X" Padding="4,0"
                                                    Command="{Binding CloseSpellSuggestionsCommand}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding SpellSuggestions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SpellSuggestionViewModel">
                                                    <Border Background="{DynamicResource RbSurface2}"
                                                            CornerRadius="4" Padding="8" Margin="0,2">
                                                        <StackPanel Spacing="4">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock FontWeight="SemiBold">
                                                                    <Run Text="Misspelled: "/>
                                                                    <Run Text="{Binding MisspelledWord}" Foreground="Red"/>
                                                                </TextBlock>
                                                                <Button Grid.Column="1" Content="Add to Dictionary"
                                                                        Padding="4,2" FontSize="11"
                                                                        Command="{Binding AddToDictionaryCommand}"/>
                                                            </Grid>
                                                            <WrapPanel>
                                                                <TextBlock Text="Suggestions: " FontSize="11" Opacity="0.7"
                                                                           VerticalAlignment="Center"/>
                                                                <ItemsControl ItemsSource="{Binding Suggestions}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Content="{Binding}" Margin="2"
                                                                                    Padding="6,2" FontSize="11"
                                                                                    Command="{Binding $parent[ItemsControl].((vm:SpellSuggestionViewModel)DataContext).ApplySuggestionCommand}"
                                                                                    CommandParameter="{Binding}"/>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Work Experience -->
                        <Border Background="{DynamicResource RbSurface1}"
                                IsVisible="{Binding SelectedEditorSection, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=experience}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Work Experience" FontWeight="SemiBold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="+ Add" Command="{Binding AddExperienceCommand}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Experiences}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ExperienceViewModel">
                                            <Border Background="{DynamicResource RbSurface2}"
                                                    CornerRadius="4" Padding="10" Margin="0,5">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                                        <TextBox Grid.Column="0" Watermark="Job Title" Text="{Binding JobTitle}" AutomationProperties.Name="Job Title"/>
                                                        <Button Grid.Column="1" Content="^" Width="28" Margin="5,0,0,0"
                                                                ToolTip.Tip="Move Up"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveExperienceUpCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="2" Content="v" Width="28" Margin="2,0,0,0"
                                                                ToolTip.Tip="Move Down"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveExperienceDownCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="3" Content="X" Margin="5,0,0,0"
                                                                ToolTip.Tip="Remove"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveExperienceCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                    <TextBox Watermark="Company" Text="{Binding Company}" AutomationProperties.Name="Company"/>
                                                    <TextBox Watermark="Location" Text="{Binding Location}" AutomationProperties.Name="Location"/>
                                                    <Grid ColumnDefinitions="Auto,5,Auto,20,Auto,5,Auto,10,Auto">
                                                        <ComboBox Grid.Column="0" Width="70"
                                                                  ItemsSource="{x:Static vm:DateOptions.Months}"
                                                                  SelectedItem="{Binding StartMonthName}"
                                                                  PlaceholderText="Month"/>
                                                        <ComboBox Grid.Column="2" Width="80"
                                                                  ItemsSource="{x:Static vm:DateOptions.Years}"
                                                                  SelectedItem="{Binding StartYear}"
                                                                  PlaceholderText="Year"/>
                                                        <TextBlock Grid.Column="3" Text="to" VerticalAlignment="Center"/>
                                                        <ComboBox Grid.Column="4" Width="70"
                                                                  ItemsSource="{x:Static vm:DateOptions.Months}"
                                                                  SelectedItem="{Binding EndMonthName}"
                                                                  IsEnabled="{Binding !IsCurrentRole}"
                                                                  PlaceholderText="Month"/>
                                                        <ComboBox Grid.Column="6" Width="80"
                                                                  ItemsSource="{x:Static vm:DateOptions.Years}"
                                                                  SelectedItem="{Binding EndYear}"
                                                                  IsEnabled="{Binding !IsCurrentRole}"
                                                                  PlaceholderText="Year"/>
                                                        <CheckBox Grid.Column="8" Content="Current" IsChecked="{Binding IsCurrentRole}"/>
                                                    </Grid>
                                                    <TextBox Watermark="Description" Text="{Binding Description}"
                                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" AutomationProperties.Name="Description"/>
                                                    <TextBox Watermark="Achievements (one per line)" Text="{Binding Achievements}"
                                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" AutomationProperties.Name="Achievements"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Education -->
                        <Border Background="{DynamicResource RbSurface1}"
                                IsVisible="{Binding SelectedEditorSection, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=education}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Education" FontWeight="SemiBold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="+ Add" Command="{Binding AddEducationCommand}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding EducationList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EducationViewModel">
                                            <Border Background="{DynamicResource RbSurface2}"
                                                    CornerRadius="4" Padding="10" Margin="0,5">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                        <TextBox Grid.Column="0" Watermark="Degree" Text="{Binding Degree}" AutomationProperties.Name="Degree"/>
                                                        <Button Grid.Column="1" Content="^" Width="28" Margin="5,0,0,0"
                                                                ToolTip.Tip="Move Up"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveEducationUpCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="2" Content="v" Width="28" Margin="2,0,0,0"
                                                                ToolTip.Tip="Move Down"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveEducationDownCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="3" Content="X" Margin="5,0,0,0"
                                                                ToolTip.Tip="Remove"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveEducationCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                    <TextBox Watermark="Field of Study" Text="{Binding FieldOfStudy}" AutomationProperties.Name="Field of Study"/>
                                                    <TextBox Watermark="Institution" Text="{Binding Institution}" AutomationProperties.Name="Institution"/>
                                                    <TextBox Watermark="Location" Text="{Binding Location}" AutomationProperties.Name="Location"/>
                                                    <Grid ColumnDefinitions="Auto,20,Auto,10,*">
                                                        <ComboBox Grid.Column="0" Width="80"
                                                                  ItemsSource="{x:Static vm:DateOptions.Years}"
                                                                  SelectedItem="{Binding StartYear}"
                                                                  PlaceholderText="Start Year"/>
                                                        <ComboBox Grid.Column="2" Width="80"
                                                                  ItemsSource="{x:Static vm:DateOptions.Years}"
                                                                  SelectedItem="{Binding EndYear}"
                                                                  IsEnabled="{Binding !IsCurrentlyStudying}"
                                                                  PlaceholderText="End Year"/>
                                                        <CheckBox Grid.Column="4" Content="Currently studying"
                                                                  IsChecked="{Binding IsCurrentlyStudying}"/>
                                                    </Grid>
                                                    <TextBox Watermark="Grade/GPA" Text="{Binding Grade}" AutomationProperties.Name="Grade/GPA"/>
                                                    <TextBox Watermark="Description" Text="{Binding Description}"
                                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" AutomationProperties.Name="Description"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Skills -->
                        <Border Background="{DynamicResource RbSurface1}"
                                IsVisible="{Binding SelectedEditorSection, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=skills}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Skills" FontWeight="SemiBold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="+ Add" Command="{Binding AddSkillCommand}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Skills}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SkillViewModel">
                                            <Grid ColumnDefinitions="*,10,*,10,Auto,Auto,Auto,Auto" Margin="0,3">
                                                <TextBox Grid.Column="0" Watermark="Skill Name" Text="{Binding Name}" AutomationProperties.Name="Skill Name"/>
                                                <TextBox Grid.Column="2" Watermark="Category" Text="{Binding Category}" AutomationProperties.Name="Category"/>
                                                <ComboBox Grid.Column="4" Width="120"
                                                          ToolTip.Tip="Proficiency level"
                                                          ItemsSource="{x:Static vm:SkillViewModel.AvailableLevels}"
                                                          SelectedItem="{Binding Level}"/>
                                                <Button Grid.Column="5" Content="^" Width="28" Margin="5,0,0,0"
                                                        ToolTip.Tip="Move Up"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveSkillUpCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="6" Content="v" Width="28" Margin="2,0,0,0"
                                                        ToolTip.Tip="Move Down"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveSkillDownCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="7" Content="X" Margin="5,0,0,0"
                                                        ToolTip.Tip="Remove"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveSkillCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Languages -->
                        <Border Background="{DynamicResource RbSurface1}"
                                IsVisible="{Binding SelectedEditorSection, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=languages}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Languages" FontWeight="SemiBold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="+ Add" Command="{Binding AddLanguageCommand}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Languages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LanguageViewModel">
                                            <Grid ColumnDefinitions="*,10,*,Auto,Auto,Auto" Margin="0,3">
                                                <TextBox Grid.Column="0" Watermark="Language" Text="{Binding Name}" AutomationProperties.Name="Language"/>
                                                <ComboBox Grid.Column="2"
                                                          ItemsSource="{x:Static vm:LanguageViewModel.AvailableProficiencies}"
                                                          SelectedItem="{Binding Proficiency}"
                                                          HorizontalAlignment="Stretch"/>
                                                <Button Grid.Column="3" Content="^" Width="28" Margin="5,0,0,0"
                                                        ToolTip.Tip="Move Up"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveLanguageUpCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="4" Content="v" Width="28" Margin="2,0,0,0"
                                                        ToolTip.Tip="Move Down"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveLanguageDownCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="5" Content="X" Margin="5,0,0,0"
                                                        ToolTip.Tip="Remove"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveLanguageCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Projects -->
                        <Border Background="{DynamicResource RbSurface1}"
                                IsVisible="{Binding SelectedEditorSection, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=projects}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Projects" FontWeight="SemiBold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="+ Add" Command="{Binding AddProjectCommand}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Projects}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProjectViewModel">
                                            <Border Background="{DynamicResource RbSurface2}"
                                                    CornerRadius="4" Padding="10" Margin="0,5">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                        <TextBox Grid.Column="0" Watermark="Project Name" Text="{Binding Name}" AutomationProperties.Name="Project Name"/>
                                                        <Button Grid.Column="1" Content="^" Width="28" Margin="5,0,0,0"
                                                                ToolTip.Tip="Move Up"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveProjectUpCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="2" Content="v" Width="28" Margin="2,0,0,0"
                                                                ToolTip.Tip="Move Down"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveProjectDownCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="3" Content="X" Margin="5,0,0,0"
                                                                ToolTip.Tip="Remove"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveProjectCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                    <TextBox Watermark="Description" Text="{Binding Description}"
                                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" AutomationProperties.Name="Description"/>
                                                    <TextBox Watermark="Highlights (one per line)" Text="{Binding Highlights}"
                                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" AutomationProperties.Name="Highlights"/>
                                                    <TextBox Watermark="Technologies (comma separated)" Text="{Binding Technologies}" AutomationProperties.Name="Technologies"/>
                                                    <TextBox Watermark="URL" Text="{Binding Url}" AutomationProperties.Name="URL"/>
                                                    <Grid ColumnDefinitions="Auto,5,Auto,20,Auto,5,Auto,10,Auto">
                                                        <ComboBox Grid.Column="0" Width="70"
                                                                  ItemsSource="{x:Static vm:DateOptions.Months}"
                                                                  SelectedItem="{Binding StartMonthName}"
                                                                  PlaceholderText="Month"/>
                                                        <ComboBox Grid.Column="2" Width="80"
                                                                  ItemsSource="{x:Static vm:DateOptions.Years}"
                                                                  SelectedItem="{Binding StartYear}"
                                                                  PlaceholderText="Year"/>
                                                        <TextBlock Grid.Column="3" Text="to" VerticalAlignment="Center"/>
                                                        <ComboBox Grid.Column="4" Width="70"
                                                                  ItemsSource="{x:Static vm:DateOptions.Months}"
                                                                  SelectedItem="{Binding EndMonthName}"
                                                                  IsEnabled="{Binding !IsOngoing}"
                                                                  PlaceholderText="Month"/>
                                                        <ComboBox Grid.Column="6" Width="80"
                                                                  ItemsSource="{x:Static vm:DateOptions.Years}"
                                                                  SelectedItem="{Binding EndYear}"
                                                                  IsEnabled="{Binding !IsOngoing}"
                                                                  PlaceholderText="Year"/>
                                                        <CheckBox Grid.Column="8" Content="Ongoing" IsChecked="{Binding IsOngoing}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Certifications -->
                        <Border Background="{DynamicResource RbSurface1}"
                                IsVisible="{Binding SelectedEditorSection, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=certifications}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Certifications" FontWeight="SemiBold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="+ Add" Command="{Binding AddCertificationCommand}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Certifications}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CertificationViewModel">
                                            <Border Background="{DynamicResource RbSurface2}"
                                                    CornerRadius="4" Padding="10" Margin="0,5">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                        <TextBox Grid.Column="0" Watermark="Certification Name" Text="{Binding Name}" AutomationProperties.Name="Certification Name"/>
                                                        <Button Grid.Column="1" Content="^" Width="28" Margin="5,0,0,0"
                                                                ToolTip.Tip="Move Up"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveCertificationUpCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="2" Content="v" Width="28" Margin="2,0,0,0"
                                                                ToolTip.Tip="Move Down"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveCertificationDownCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="3" Content="X" Margin="5,0,0,0"
                                                                ToolTip.Tip="Remove"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveCertificationCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                    <TextBox Watermark="Issuing Organization" Text="{Binding IssuingOrganization}" AutomationProperties.Name="Issuing Organization"/>
                                                    <Grid ColumnDefinitions="Auto,5,Auto,20,Auto,5,Auto,10,Auto">
                                                        <ComboBox Grid.Column="0" Width="70"
                                                                  ToolTip.Tip="Issued"
                                                                  ItemsSource="{x:Static vm:DateOptions.Months}"
                                                                  SelectedItem="{Binding IssueMonthName}"
                                                                  PlaceholderText="Month"/>
                                                        <ComboBox Grid.Column="2" Width="80"
                                                                  ToolTip.Tip="Issued"
                                                                  ItemsSource="{x:Static vm:DateOptions.Years}"
                                                                  SelectedItem="{Binding IssueYear}"
                                                                  PlaceholderText="Year"/>
                                                        <TextBlock Grid.Column="3" Text="to" VerticalAlignment="Center"/>
                                                        <ComboBox Grid.Column="4" Width="70"
                                                                  ToolTip.Tip="Expires"
                                                                  ItemsSource="{x:Static vm:DateOptions.Months}"
                                                                  SelectedItem="{Binding ExpirationMonthName}"
                                                                  IsEnabled="{Binding !DoesNotExpire}"
                                                                  PlaceholderText="Month"/>
                                                        <ComboBox Grid.Column="6" Width="80"
                                                                  ToolTip.Tip="Expires"
                                                                  ItemsSource="{x:Static vm:DateOptions.Years}"
                                                                  SelectedItem="{Binding ExpirationYear}"
                                                                  IsEnabled="{Binding !DoesNotExpire}"
                                                                  PlaceholderText="Year"/>
                                                        <CheckBox Grid.Column="8" Content="No expiry"
                                                                  IsChecked="{Binding DoesNotExpire}"/>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,10,*">
                                                        <TextBox Grid.Column="0" Watermark="Credential ID" Text="{Binding CredentialId}" AutomationProperties.Name="Credential ID"/>
                                                        <TextBox Grid.Column="2" Watermark="Credential URL" Text="{Binding CredentialUrl}" AutomationProperties.Name="Credential URL"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Custom Sections -->
                        <Border Background="{DynamicResource RbSurface1}"
                                IsVisible="{Binding SelectedEditorSection, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=custom}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Custom Sections" FontWeight="SemiBold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="+ Add Section" Command="{Binding AddCustomSectionCommand}"/>
                                </Grid>
                                <TextBlock Text="Anything the standard sections do not cover: publications, awards, volunteering..."
                                           FontSize="11" Opacity="0.6"/>
                                <ItemsControl ItemsSource="{Binding CustomSections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CustomSectionViewModel">
                                            <Border Background="{DynamicResource RbSurface2}"
                                                    CornerRadius="4" Padding="10" Margin="0,5">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBox Grid.Column="0" Watermark="Section Title" Text="{Binding Title}" AutomationProperties.Name="Section Title"/>
                                                        <Button Grid.Column="1" Content="X" Margin="5,0,0,0"
                                                                ToolTip.Tip="Remove section"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveCustomSectionCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>

                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:CustomSectionItemViewModel">
                                                                <Border Background="{DynamicResource RbSurface1}"
                                                                        CornerRadius="4" Padding="8" Margin="0,4">
                                                                    <StackPanel Spacing="6">
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <TextBox Grid.Column="0" Watermark="Item Title" Text="{Binding Title}" AutomationProperties.Name="Item Title"/>
                                                                            <Button Grid.Column="1" Content="X" Margin="5,0,0,0"
                                                                                    ToolTip.Tip="Remove item"
                                                                                    Command="{Binding $parent[ItemsControl].((vm:CustomSectionViewModel)DataContext).RemoveItemCommand}"
                                                                                    CommandParameter="{Binding}"/>
                                                                        </Grid>
                                                                        <TextBox Watermark="Subtitle" Text="{Binding Subtitle}" AutomationProperties.Name="Subtitle"/>
                                                                        <TextBox Watermark="Description" Text="{Binding Description}"
                                                                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" AutomationProperties.Name="Description"/>
                                                                        <Grid ColumnDefinitions="Auto,5,Auto,20,Auto,5,Auto">
                                                                            <ComboBox Grid.Column="0" Width="70"
                                                                                      ItemsSource="{x:Static vm:DateOptions.Months}"
                                                                                      SelectedItem="{Binding StartMonthName}"
                                                                                      PlaceholderText="Month"/>
                                                                            <ComboBox Grid.Column="2" Width="80"
                                                                                      ItemsSource="{x:Static vm:DateOptions.Years}"
                                                                                      SelectedItem="{Binding StartYear}"
                                                                                      PlaceholderText="Year"/>
                                                                            <TextBlock Grid.Column="3" Text="to" VerticalAlignment="Center"/>
                                                                            <ComboBox Grid.Column="4" Width="70"
                                                                                      ItemsSource="{x:Static vm:DateOptions.Months}"
                                                                                      SelectedItem="{Binding EndMonthName}"
                                                                                      PlaceholderText="Month"/>
                                                                            <ComboBox Grid.Column="6" Width="80"
                                                                                      ItemsSource="{x:Static vm:DateOptions.Years}"
                                                                                      SelectedItem="{Binding EndYear}"
                                                                                      PlaceholderText="Year"/>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Button Content="+ Add Item" HorizontalAlignment="Left"
                                                            Command="{Binding AddItemCommand}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

</UserControl>
