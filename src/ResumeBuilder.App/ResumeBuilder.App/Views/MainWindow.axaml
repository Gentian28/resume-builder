<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ResumeBuilder.App.ViewModels"
        xmlns:models="using:ResumeBuilder.Core.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="ResumeBuilder.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Resume Builder"
        Width="1400" Height="900"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCurrentResumeCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenResumeListCommand}"/>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding CreateNewResumeCommand}"/>
        <KeyBinding Gesture="Ctrl+T" Command="{Binding ToggleThemeCommand}"/>
    </Window.KeyBindings>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Menu Bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_New Resume" Command="{Binding CreateNewResumeCommand}" InputGesture="Ctrl+N"/>
                <MenuItem Header="_Open..." Command="{Binding OpenResumeListCommand}" InputGesture="Ctrl+O"/>
                <MenuItem Header="_Save" Command="{Binding SaveCurrentResumeCommand}" InputGesture="Ctrl+S"/>
                <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="New _Cover Letter" Command="{Binding NewCoverLetterCommand}"/>
                <MenuItem Header="Cover _Letters..." Command="{Binding OpenCoverLetterListCommand}"/>
                <Separator/>
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}"
                          InputGesture="Ctrl+Z"
                          IsEnabled="{Binding CanUndo}">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Undo"/>
                            <TextBlock Text="{Binding NextUndoDescription, StringFormat=' ({0})'}"
                                       IsVisible="{Binding NextUndoDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Opacity="0.6"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}"
                          InputGesture="Ctrl+Y"
                          IsEnabled="{Binding CanRedo}">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Redo"/>
                            <TextBlock Text="{Binding NextRedoDescription, StringFormat=' ({0})'}"
                                       IsVisible="{Binding NextRedoDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Opacity="0.6"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Import">
                    <MenuItem Header="JSON Resume (.json)" Command="{Binding ImportJsonResumeCommand}"/>
                    <MenuItem Header="LinkedIn Export (.zip)" Command="{Binding ImportLinkedInCommand}"/>
                    <MenuItem Header="PDF Resume (.pdf)" Command="{Binding ImportPdfCommand}"/>
                </MenuItem>
                <MenuItem Header="Export">
                    <MenuItem Header="PDF" Command="{Binding ExportCommand}" CommandParameter="PDF"/>
                    <MenuItem Header="Word (DOCX)" Command="{Binding ExportCommand}" CommandParameter="DOCX"/>
                    <MenuItem Header="HTML" Command="{Binding ExportCommand}" CommandParameter="HTML"/>
                    <MenuItem Header="PNG Image" Command="{Binding ExportCommand}" CommandParameter="PNG"/>
                    <Separator/>
                    <MenuItem Header="JSON Resume (Standard)" Command="{Binding ExportCommand}" CommandParameter="JSONRESUME"/>
                    <MenuItem Header="JSON (App Backup)" Command="{Binding ExportCommand}" CommandParameter="JSON"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Templates">
                <MenuItem Header="Choose Template..." Click="ShowTemplateGallery_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Spell Check">
                    <MenuItem Header="Toggle Spell Check" Command="{Binding ToggleSpellCheckCommand}"/>
                    <MenuItem Header="Check Summary..." Command="{Binding ShowSpellingSuggestionsCommand}"/>
                </MenuItem>
                <MenuItem Header="AI Assistant">
                    <MenuItem Header="Show AI Panel" Click="ToggleAiPanel_Click"/>
                    <Separator/>
                    <MenuItem Header="Generate Summary" Command="{Binding GenerateAiSummaryCommand}"
                              IsEnabled="{Binding IsAiConfigured}"/>
                    <MenuItem Header="Suggest Skills" Command="{Binding SuggestAiSkillsCommand}"
                              IsEnabled="{Binding IsAiConfigured}"/>
                </MenuItem>
                <MenuItem Header="Tailor to Job">
                    <MenuItem Header="Show Tailor Panel" Click="ToggleTailorPanel_Click"/>
                    <MenuItem Header="Tailor to Job" Command="{Binding TailorToJobCommand}"/>
                    <MenuItem Header="Apply Accepted Rewrites" Command="{Binding ApplyAcceptedEditsCommand}"/>
                    <MenuItem Header="Save as Variant for This Job" Command="{Binding SaveAsVariantCommand}"/>
                    <MenuItem Header="Clear Analysis" Command="{Binding ClearTailoringCommand}"/>
                </MenuItem>
                <MenuItem Header="Sync">
                    <MenuItem Header="Show Sync Panel" Click="ToggleSyncPanel_Click"/>
                    <Separator/>
                    <MenuItem Header="Sync All Resumes" Command="{Binding SyncAllCommand}"
                              IsEnabled="{Binding IsSyncConfigured}"/>
                    <MenuItem Header="Sync Current Resume" Command="{Binding SyncCurrentResumeCommand}"
                              IsEnabled="{Binding IsSyncConfigured}"/>
                    <MenuItem Header="Refresh Remote List" Command="{Binding RefreshRemoteResumesCommand}"
                              IsEnabled="{Binding IsSyncConfigured}"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom In" Command="{Binding ZoomInCommand}"/>
                <MenuItem Header="Zoom Out" Command="{Binding ZoomOutCommand}"/>
                <MenuItem Header="Reset Zoom" Command="{Binding ZoomResetCommand}"/>
                <Separator/>
                <MenuItem Header="Theme">
                    <MenuItem Header="Toggle Light/Dark" Command="{Binding ToggleThemeCommand}"
                              InputGesture="Ctrl+T"/>
                    <Separator/>
                    <MenuItem Header="Light" Command="{Binding SetLightThemeCommand}"/>
                    <MenuItem Header="Dark" Command="{Binding SetDarkThemeCommand}"/>
                    <MenuItem Header="System" Command="{Binding SetSystemThemeCommand}"/>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="450,*">
            <!-- Left Panel - Editor -->
            <Border Grid.Column="0" Background="{DynamicResource RbSurface2}"
                    BorderBrush="{DynamicResource RbBorder}" BorderThickness="0,0,1,0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15" Spacing="15">

                        <!-- AI Assistant Panel -->
                        <Border Background="{DynamicResource RbSurface1}"
                                CornerRadius="8" Padding="15" IsVisible="{Binding ShowAiPanel}">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Text="AI Assistant" FontWeight="SemiBold" FontSize="14"/>
                                    <Border Grid.Column="1" Background="#3316a34a" CornerRadius="8"
                                            Padding="6,1" Margin="8,0,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            IsVisible="{Binding IsAiLocal}">
                                        <TextBlock Text="Local" FontSize="10"/>
                                    </Border>
                                    <Button Grid.Column="2" Content="X" Padding="4,0"
                                            Click="ToggleAiPanel_Click"/>
                                </Grid>

                                <!-- Endpoint Configuration -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Endpoint" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="Any OpenAI-compatible server works: OpenAI itself, or a local LLM such as Ollama or LM Studio."
                                               FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Button Content="Use OpenAI" Padding="8,3" FontSize="11"
                                                Command="{Binding UseOpenAiEndpointCommand}"/>
                                        <Button Content="Use local LLM" Padding="8,3" FontSize="11"
                                                Command="{Binding UseLocalAiEndpointCommand}"/>
                                    </StackPanel>
                                    <TextBox Watermark="Base URL (e.g. https://api.openai.com/v1)"
                                             Text="{Binding AiBaseUrl}"/>
                                    <TextBox Watermark="Model (e.g. gpt-4o-mini, llama3)"
                                             Text="{Binding AiModel}"/>
                                    <TextBox Watermark="API key (not needed for a local endpoint)"
                                             Text="{Binding AiApiKey}"
                                             PasswordChar="*"/>
                                    <Button Content="Apply endpoint settings"
                                            Command="{Binding ApplyAiSettingsCommand}"
                                            HorizontalAlignment="Left"/>
                                    <Border Background="{DynamicResource RbSurface2}"
                                            CornerRadius="4" Padding="8">
                                        <TextBlock Text="{Binding AiPrivacyNotice}"
                                                   FontSize="11" Opacity="0.85" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>

                                <!-- AI Features (when configured) -->
                                <StackPanel Spacing="10" IsVisible="{Binding IsAiConfigured}">
                                    <TextBlock Text="{Binding AiStatusMessage}"
                                               FontSize="11" Opacity="0.7"
                                               IsVisible="{Binding AiStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                    <!-- Generate Summary -->
                                    <Border Background="{DynamicResource RbSurface2}"
                                            CornerRadius="4" Padding="10">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Summary Generator" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="Generate a professional summary based on your experience and skills."
                                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                                            <Button Content="Generate Summary"
                                                    Command="{Binding GenerateAiSummaryCommand}"
                                                    IsEnabled="{Binding !IsAiProcessing}"
                                                    HorizontalAlignment="Left"/>
                                            <TextBox Text="{Binding AiGeneratedSummary}"
                                                     IsReadOnly="True"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     MinHeight="60"
                                                     IsVisible="{Binding AiGeneratedSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            <Button Content="Apply to Summary"
                                                    Command="{Binding ApplyAiSummaryCommand}"
                                                    IsVisible="{Binding AiGeneratedSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                    HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Skill Suggestions -->
                                    <Border Background="{DynamicResource RbSurface2}"
                                            CornerRadius="4" Padding="10">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Skill Suggestions" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="Get AI-suggested skills based on your job title and experience."
                                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                                            <Button Content="Suggest Skills"
                                                    Command="{Binding SuggestAiSkillsCommand}"
                                                    IsEnabled="{Binding !IsAiProcessing}"
                                                    HorizontalAlignment="Left"/>
                                            <ItemsControl ItemsSource="{Binding AiSkillSuggestions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource RbSurface3}"
                                                                CornerRadius="4" Padding="6,4" Margin="0,2">
                                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                                <Button Grid.Column="1" Content="+" Width="24" Height="24"
                                                                        Margin="5,0" Padding="0"
                                                                        ToolTip.Tip="Add this skill"
                                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).AddSuggestedSkillCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                                <Button Grid.Column="2" Content="X" Width="24" Height="24"
                                                                        Padding="0"
                                                                        ToolTip.Tip="Dismiss"
                                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DismissSuggestedSkillCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Processing Indicator -->
                                    <ProgressBar IsIndeterminate="True"
                                                 IsVisible="{Binding IsAiProcessing}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Tailor to Job Panel -->
                        <Border Background="{DynamicResource RbSurface1}"
                                CornerRadius="8" Padding="15" IsVisible="{Binding ShowTailorPanel}">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Tailor to Job" FontWeight="SemiBold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="X" Padding="4,0"
                                            Click="ToggleTailorPanel_Click"/>
                                </Grid>

                                <TextBlock Text="Paste the job description. You get a keyword match, and - when AI is configured - proposed rewrites you can accept one by one."
                                           FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>

                                <TextBox Text="{Binding TargetRoleText}"
                                         Watermark="Target role (e.g. Senior Backend Engineer)"/>

                                <TextBox Text="{Binding JobDescriptionText}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Watermark="Paste job description here..."
                                         MinHeight="100"
                                         MaxHeight="150"/>

                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Button Content="Tailor"
                                            Command="{Binding TailorToJobCommand}"
                                            IsEnabled="{Binding !IsTailoring}"/>
                                    <Button Content="Save as variant for this job"
                                            Command="{Binding SaveAsVariantCommand}"
                                            ToolTip.Tip="Branches this resume into a variant tailored for this posting"/>
                                </StackPanel>

                                <ProgressBar IsIndeterminate="True" Height="4"
                                             IsVisible="{Binding IsTailoring}"/>

                                <!-- AI status (never blocks the keyword analysis below) -->
                                <Border Background="#33FFA500" CornerRadius="4" Padding="8"
                                        IsVisible="{Binding TailorAiError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{Binding TailorAiError}"
                                               FontSize="11" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Proposed rewrites -->
                                <StackPanel Spacing="8" IsVisible="{Binding HasTailoredEdits}">
                                    <TextBlock Text="Proposed rewrites" FontWeight="SemiBold" FontSize="12"/>
                                    <ItemsControl ItemsSource="{Binding TailoredEdits}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TailoredEditViewModel">
                                                <Border Background="{DynamicResource RbSurface2}"
                                                        CornerRadius="4" Padding="10" Margin="0,3">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnDefinitions="Auto,*">
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding Accepted}"
                                                                      VerticalAlignment="Center"
                                                                      ToolTip.Tip="Accept this rewrite"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding TargetDescription}"
                                                                       FontWeight="SemiBold" FontSize="12"
                                                                       TextWrapping="Wrap"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*,8,*">
                                                            <StackPanel Grid.Column="0" Spacing="2">
                                                                <TextBlock Text="Original" FontSize="10" Opacity="0.6"/>
                                                                <TextBlock Text="{Binding Original}" FontSize="11"
                                                                           TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Spacing="2">
                                                                <TextBlock Text="Proposed" FontSize="10" Opacity="0.6"/>
                                                                <TextBlock Text="{Binding Proposed}" FontSize="11"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource RbAccent}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Rationale}" FontSize="10"
                                                                   Opacity="0.7" TextWrapping="Wrap"
                                                                   IsVisible="{Binding Rationale, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Apply accepted"
                                            Command="{Binding ApplyAcceptedEditsCommand}"
                                            ToolTip.Tip="Applies the ticked rewrites; Ctrl+Z reverts them"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>

                                <!-- Results (when available) -->
                                <StackPanel Spacing="10" IsVisible="{Binding HasKeywordAnalysis}">
                                    <!-- Score -->
                                    <Border Background="{DynamicResource RbSurface2}"
                                            CornerRadius="4" Padding="10">
                                        <StackPanel Spacing="5">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Match Score" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding KeywordMatchScore, StringFormat={}{0}%}"
                                                           FontWeight="Bold" FontSize="18"/>
                                            </Grid>
                                            <ProgressBar Value="{Binding KeywordMatchScore}"
                                                         Maximum="100"
                                                         Height="8"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Missing Keywords -->
                                    <Expander Header="Missing Keywords" IsExpanded="True"
                                              IsVisible="{Binding MissingKeywords.Count}">
                                        <StackPanel Spacing="4" Margin="0,5,0,0">
                                            <TextBlock Text="Add these to improve your match:"
                                                       FontSize="11" Opacity="0.7"/>
                                            <ItemsControl ItemsSource="{Binding MissingKeywords}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding}"
                                                                Margin="0,0,4,4"
                                                                Padding="8,4"
                                                                FontSize="11"
                                                                ToolTip.Tip="Click to add as skill"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).AddMissingKeywordAsSkillCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Matched Keywords -->
                                    <Expander Header="Matched Keywords">
                                        <ItemsControl ItemsSource="{Binding MatchedKeywords}" Margin="0,5,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                        <TextBlock Text="{Binding Keyword}" FontSize="11"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding ResumeCount, StringFormat='({0}x)'}"
                                                                   FontSize="11" Opacity="0.6"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>

                                    <!-- Suggestions -->
                                    <Expander Header="Suggestions" IsExpanded="True"
                                              IsVisible="{Binding KeywordSuggestions.Count}">
                                        <ItemsControl ItemsSource="{Binding KeywordSuggestions}" Margin="0,5,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>

                                    <!-- Warnings -->
                                    <Expander Header="Warnings"
                                              IsVisible="{Binding KeywordWarnings.Count}">
                                        <ItemsControl ItemsSource="{Binding KeywordWarnings}" Margin="0,5,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="11"
                                                               Foreground="Orange"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>

                                    <!-- Suggested Skills -->
                                    <Expander Header="Suggested Skills"
                                              IsVisible="{Binding TailorSuggestedSkills.Count}">
                                        <StackPanel Spacing="4" Margin="0,5,0,0">
                                            <TextBlock Text="Click to add as a skill:" FontSize="11" Opacity="0.7"/>
                                            <ItemsControl ItemsSource="{Binding TailorSuggestedSkills}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding}"
                                                                Margin="0,0,4,4" Padding="8,4" FontSize="11"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).AddMissingKeywordAsSkillCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>

                                    <Button Content="Clear Analysis"
                                            Command="{Binding ClearTailoringCommand}"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Sync Panel -->
                        <Border Background="{DynamicResource RbSurface1}"
                                CornerRadius="8" Padding="15" IsVisible="{Binding ShowSyncPanel}">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Sync Settings" FontWeight="SemiBold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="X" Padding="4,0"
                                            Click="ToggleSyncPanel_Click"/>
                                </Grid>

                                <TextBlock Text="Two-way sync with a local folder (which can itself be a cloud-synced folder like Dropbox, OneDrive, or Google Drive). Newer changes are copied in both directions."
                                           FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>

                                <!-- Configuration -->
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Sync Folder:" FontSize="12"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Text="{Binding SyncFolderPath}"
                                                 Watermark="C:\Users\...\ResumeBackups"/>
                                        <Button Grid.Column="1" Content="Browse..."
                                                Command="{Binding BrowseSyncFolderCommand}"
                                                Margin="5,0,0,0"/>
                                    </Grid>
                                    <TextBlock Text="When both sides changed:" FontSize="12" Margin="0,5,0,0"/>
                                    <ComboBox ItemsSource="{Binding ConflictResolutions}"
                                              SelectedItem="{Binding SelectedConflictResolution}"
                                              HorizontalAlignment="Stretch"/>
                                    <Button Content="Configure Sync"
                                            Command="{Binding ConfigureSyncCommand}"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>

                                <!-- Status -->
                                <Border Background="{DynamicResource RbSurface2}"
                                        CornerRadius="4" Padding="10">
                                    <StackPanel Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Status:" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SyncStatusText}"
                                                       Opacity="0.8" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" IsVisible="{Binding HasSyncResult}">
                                            <TextBlock Text="{Binding SyncUploadedCount, StringFormat='Uploaded: {0}'}"
                                                       FontSize="11" Opacity="0.8"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SyncDownloadedCount, StringFormat='Downloaded: {0}'}"
                                                       FontSize="11" Opacity="0.8"/>
                                        </Grid>
                                        <ProgressBar IsIndeterminate="True"
                                                     IsVisible="{Binding IsSyncing}"
                                                     Height="4"/>
                                    </StackPanel>
                                </Border>

                                <!-- Conflicts -->
                                <Border Background="#33FFA500" CornerRadius="4" Padding="10"
                                        IsVisible="{Binding SyncConflicts.Count}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Conflicts" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="These resumes changed on both sides. The losing version was kept next to the winner as a .conflict.json file in the sync folder."
                                                   FontSize="11" Opacity="0.8" TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{Binding SyncConflicts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SyncConflictViewModel">
                                                    <StackPanel Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding ResumeName}" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.7"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Sync Actions (when configured) -->
                                <StackPanel Spacing="10" IsVisible="{Binding IsSyncConfigured}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Button Content="Sync All"
                                                Command="{Binding SyncAllCommand}"
                                                IsEnabled="{Binding !IsSyncing}"/>
                                        <Button Content="Sync Current"
                                                Command="{Binding SyncCurrentResumeCommand}"
                                                IsEnabled="{Binding !IsSyncing}"/>
                                        <Button Content="Refresh"
                                                Command="{Binding RefreshRemoteResumesCommand}"
                                                IsEnabled="{Binding !IsSyncing}"/>
                                    </StackPanel>

                                    <!-- Remote Files -->
                                    <Expander Header="Remote Resumes" IsExpanded="True">
                                        <StackPanel Spacing="4" Margin="0,5,0,0">
                                            <TextBlock Text="Click to import a remote resume:"
                                                       FontSize="11" Opacity="0.7"
                                                       IsVisible="{Binding RemoteResumes.Count}"/>
                                            <TextBlock Text="No resumes found in sync folder"
                                                       FontSize="11" Opacity="0.5"
                                                       IsVisible="{Binding !RemoteResumes.Count}"/>
                                            <ItemsControl ItemsSource="{Binding RemoteResumes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Margin="0,2" Padding="8,6"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Left"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ImportRemoteResumeCommand}"
                                                                CommandParameter="{Binding Path}">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="12"/>
                                                                    <TextBlock Text="{Binding LastModifiedDisplay}"
                                                                               FontSize="10" Opacity="0.6"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding SizeDisplay}"
                                                                           FontSize="10" Opacity="0.6"
                                                                           VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Resume Name -->
                        <Border Background="{DynamicResource RbSurface1}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Resume Name" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SaveStateText}"
                                               FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBox Watermark="Untitled Resume" Text="{Binding ResumeName}"/>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Button Content="Save" Command="{Binding SaveCurrentResumeCommand}"/>
                                    <Button Content="Save As..." Command="{Binding SaveAsCommand}"/>
                                    <Button Content="Open..." Command="{Binding OpenResumeListCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Template Selector -->
                        <Border Background="{DynamicResource RbSurface1}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Template" FontWeight="SemiBold" FontSize="14"/>
                                <Button Content="{Binding SelectedTemplate.Name, FallbackValue='Select Template'}"
                                        Click="ShowTemplateGallery_Click"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- Template Customization -->
                        <Border Background="{DynamicResource RbSurface1}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Customize Appearance" FontWeight="SemiBold" FontSize="14"/>
                                    <ToggleButton Grid.Column="1" Content="..."
                                                  IsChecked="{Binding ShowCustomizationPanel}"
                                                  Padding="8,2"/>
                                </Grid>

                                <StackPanel Spacing="10" IsVisible="{Binding ShowCustomizationPanel}">
                                    <!-- Accent Color -->
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Accent Color" FontSize="12" Opacity="0.8"/>
                                        <ItemsControl ItemsSource="{Binding PresetColors}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Button Width="24" Height="24" Margin="2"
                                                            Padding="0"
                                                            CornerRadius="4"
                                                            Background="{Binding Converter={x:Static vm:MainWindowViewModel.HexToColorConverter}}"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SetAccentColorCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Color Picker Button and Hex Input -->
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Button Grid.Column="0"
                                                    Width="30" Height="30"
                                                    Padding="0" Margin="0,0,5,0"
                                                    ToolTip.Tip="Open color picker"
                                                    Background="Transparent"
                                                    Command="{Binding ToggleAccentColorPickerCommand}">
                                                <Border Width="28" Height="28" CornerRadius="4"
                                                        BorderBrush="{DynamicResource RbBorder}"
                                                        BorderThickness="1"
                                                        Background="{Binding AccentColor, Converter={x:Static vm:MainWindowViewModel.HexToColorConverter}}"/>
                                            </Button>
                                            <TextBox Grid.Column="1"
                                                     Watermark="Hex color (e.g., #2563eb)"
                                                     Text="{Binding AccentColor, Mode=TwoWay}"
                                                     MaxLength="7"/>
                                        </Grid>
                                        <!-- Inline Color Picker (shown when toggled) -->
                                        <ColorView IsVisible="{Binding ShowAccentColorPicker}"
                                                   Color="{Binding AccentColorValue, Mode=TwoWay}"
                                                   ColorSpectrumShape="Ring"
                                                   IsAlphaVisible="False"
                                                   IsColorSpectrumSliderVisible="True"
                                                   IsComponentSliderVisible="False"
                                                   IsHexInputVisible="False"
                                                   Margin="0,5,0,0"
                                                   HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <!-- Font Family -->
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Body Font" FontSize="12" Opacity="0.8"/>
                                        <ComboBox ItemsSource="{Binding AvailableFonts}"
                                                  SelectedItem="{Binding SelectedFontFamily}"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Heading Font" FontSize="12" Opacity="0.8"/>
                                        <ComboBox ItemsSource="{Binding AvailableFonts}"
                                                  SelectedItem="{Binding SelectedHeadingFontFamily}"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <!-- Font Size Scale -->
                                    <StackPanel Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Font Size" FontSize="12" Opacity="0.8"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FontSizeScale, StringFormat={}{0:P0}}"
                                                       FontSize="12" Opacity="0.8"/>
                                        </Grid>
                                        <Slider Minimum="0.8" Maximum="1.3"
                                                Value="{Binding FontSizeScale}"
                                                TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                    </StackPanel>

                                    <!-- Line Spacing -->
                                    <StackPanel Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Line Spacing" FontSize="12" Opacity="0.8"/>
                                            <TextBlock Grid.Column="1" Text="{Binding LineSpacing, StringFormat={}{0:F1}}"
                                                       FontSize="12" Opacity="0.8"/>
                                        </Grid>
                                        <Slider Minimum="1.0" Maximum="2.0"
                                                Value="{Binding LineSpacing}"
                                                TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                                    </StackPanel>

                                    <!-- Page Margin -->
                                    <StackPanel Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Page Margin" FontSize="12" Opacity="0.8"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PageMargin, StringFormat={}{0:F0}px}"
                                                       FontSize="12" Opacity="0.8"/>
                                        </Grid>
                                        <Slider Minimum="15" Maximum="50"
                                                Value="{Binding PageMargin}"
                                                TickFrequency="5" IsSnapToTickEnabled="True"/>
                                    </StackPanel>

                                    <!-- Section Spacing -->
                                    <StackPanel Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Section Spacing" FontSize="12" Opacity="0.8"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SectionSpacing, StringFormat={}{0:F0}px}"
                                                       FontSize="12" Opacity="0.8"/>
                                        </Grid>
                                        <Slider Minimum="5" Maximum="30"
                                                Value="{Binding SectionSpacing}"
                                                TickFrequency="5" IsSnapToTickEnabled="True"/>
                                    </StackPanel>

                                    <!-- Reset Button -->
                                    <Button Content="Reset to Defaults"
                                            Command="{Binding ResetCustomizationCommand}"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Section Ordering -->
                        <Border Background="{DynamicResource RbSurface1}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Section Order" FontWeight="SemiBold" FontSize="14"/>
                                    <ToggleButton Grid.Column="1" Content="..."
                                                  IsChecked="{Binding ShowSectionOrderPanel}"
                                                  Padding="8,2"/>
                                </Grid>

                                <StackPanel Spacing="5" IsVisible="{Binding ShowSectionOrderPanel}">
                                    <TextBlock Text="Use the arrows to reorder sections; untick one to hide it"
                                               FontSize="11" Opacity="0.6" Margin="0,0,0,5"/>
                                    <ItemsControl ItemsSource="{Binding Sections}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SectionViewModel">
                                                <Border Background="{DynamicResource RbSurface2}"
                                                        CornerRadius="4" Padding="8" Margin="0,2">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible}"
                                                                  VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                                   VerticalAlignment="Center" Margin="8,0"
                                                                   Classes.dimmed="{Binding !IsVisible}"/>
                                                        <Button Grid.Column="2" Content="^" Width="28" Height="28"
                                                                Padding="0" Margin="2,0"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveSectionUpCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="3" Content="v" Width="28" Height="28"
                                                                Padding="0"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveSectionDownCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Reset Order"
                                            Command="{Binding ResetSectionOrderCommand}"
                                            HorizontalAlignment="Left" Margin="0,5,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Personal Information -->
                        <Border Background="{DynamicResource RbSurface1}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Personal Information" FontWeight="SemiBold" FontSize="14"/>

                                <!-- Photo Upload -->
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Grid.Column="0" Width="80" Height="80" CornerRadius="40"
                                            Background="{DynamicResource RbSurface2}"
                                            ClipToBounds="True" Margin="0,0,15,0">
                                        <Panel>
                                            <TextBlock Text="Photo" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource RbText3}"
                                                       IsVisible="{Binding !HasPhoto}"/>
                                            <Image Source="{Binding PhotoPreview}" Stretch="UniformToFill"
                                                   IsVisible="{Binding HasPhoto}"/>
                                        </Panel>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                        <Button Content="Upload Photo" Command="{Binding UploadPhotoCommand}"
                                                HorizontalAlignment="Left"/>
                                        <Button Content="Remove" Command="{Binding RemovePhotoCommand}"
                                                IsVisible="{Binding HasPhoto}"
                                                HorizontalAlignment="Left" Padding="10,5"/>
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,10,*">
                                    <TextBox Grid.Column="0" Watermark="First Name" Text="{Binding FirstName}"/>
                                    <TextBox Grid.Column="2" Watermark="Last Name" Text="{Binding LastName}"/>
                                </Grid>
                                <TextBox Watermark="Job Title" Text="{Binding JobTitle}"/>
                                <Grid ColumnDefinitions="*,10,*" RowDefinitions="Auto,Auto">
                                    <TextBox Grid.Column="0" Grid.Row="0" Watermark="Email" Text="{Binding Email}"
                                             Classes.error="{Binding EmailError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="{Binding EmailError}"
                                               Foreground="Red" FontSize="11" Margin="0,2,0,0"
                                               IsVisible="{Binding EmailError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBox Grid.Column="2" Grid.Row="0" Watermark="Phone" Text="{Binding Phone}"
                                             Classes.error="{Binding PhoneError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding PhoneError}"
                                               Foreground="Red" FontSize="11" Margin="0,2,0,0"
                                               IsVisible="{Binding PhoneError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,10,*">
                                    <TextBox Grid.Column="0" Watermark="City" Text="{Binding City}"/>
                                    <TextBox Grid.Column="2" Watermark="Country" Text="{Binding Country}"/>
                                </Grid>
                                <StackPanel Spacing="2">
                                    <TextBox Watermark="Website" Text="{Binding Website}"
                                             Classes.error="{Binding WebsiteError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding WebsiteError}"
                                               Foreground="Red" FontSize="11"
                                               IsVisible="{Binding WebsiteError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBox Watermark="LinkedIn URL" Text="{Binding LinkedIn}"
                                             Classes.error="{Binding LinkedInError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding LinkedInError}"
                                               Foreground="Red" FontSize="11"
                                               IsVisible="{Binding LinkedInError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                                <TextBox Watermark="GitHub Username" Text="{Binding GitHub}"/>
                            </StackPanel>
                        </Border>

                        <!-- Professional Summary -->
                        <Border Background="{DynamicResource RbSurface1}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Professional Summary" FontWeight="SemiBold" FontSize="14"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                        <Border Background="#FFA500" CornerRadius="10" Padding="6,2"
                                                IsVisible="{Binding SummarySpellErrorCount}"
                                                Cursor="Hand">
                                            <Border.Styles>
                                                <Style Selector="Border:pointerover">
                                                    <Setter Property="Opacity" Value="0.8"/>
                                                </Style>
                                            </Border.Styles>
                                            <TextBlock Foreground="White" FontSize="11">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} spelling issue(s)">
                                                        <Binding Path="SummarySpellErrorCount"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>
                                        <Button Content="Check" Padding="8,2"
                                                Command="{Binding ShowSpellingSuggestionsCommand}"
                                                IsVisible="{Binding SummarySpellErrorCount}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBox Watermark="Write a brief summary of your professional background..."
                                         Text="{Binding Summary}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="100"/>

                                <!-- Spell Check Suggestions Popup -->
                                <Border Background="{DynamicResource RbSurface3}"
                                        CornerRadius="4" Padding="10"
                                        IsVisible="{Binding ShowSpellSuggestions}">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Spelling Suggestions" FontWeight="SemiBold"/>
                                            <Button Grid.Column="1" Content="X" Padding="4,0"
                                                    Command="{Binding CloseSpellSuggestionsCommand}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding SpellSuggestions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SpellSuggestionViewModel">
                                                    <Border Background="{DynamicResource RbSurface2}"
                                                            CornerRadius="4" Padding="8" Margin="0,2">
                                                        <StackPanel Spacing="4">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock FontWeight="SemiBold">
                                                                    <Run Text="Misspelled: "/>
                                                                    <Run Text="{Binding MisspelledWord}" Foreground="Red"/>
                                                                </TextBlock>
                                                                <Button Grid.Column="1" Content="Add to Dictionary"
                                                                        Padding="4,2" FontSize="11"
                                                                        Command="{Binding AddToDictionaryCommand}"/>
                                                            </Grid>
                                                            <WrapPanel>
                                                                <TextBlock Text="Suggestions: " FontSize="11" Opacity="0.7"
                                                                           VerticalAlignment="Center"/>
                                                                <ItemsControl ItemsSource="{Binding Suggestions}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Content="{Binding}" Margin="2"
                                                                                    Padding="6,2" FontSize="11"
                                                                                    Command="{Binding $parent[ItemsControl].((vm:SpellSuggestionViewModel)DataContext).ApplySuggestionCommand}"
                                                                                    CommandParameter="{Binding}"/>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Work Experience -->
                        <Border Background="{DynamicResource RbSurface1}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Work Experience" FontWeight="SemiBold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="+ Add" Command="{Binding AddExperienceCommand}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Experiences}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ExperienceViewModel">
                                            <Border Background="{DynamicResource RbSurface2}"
                                                    CornerRadius="4" Padding="10" Margin="0,5">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                                        <TextBox Grid.Column="0" Watermark="Job Title" Text="{Binding JobTitle}"/>
                                                        <Button Grid.Column="1" Content="^" Width="28" Margin="5,0,0,0"
                                                                ToolTip.Tip="Move Up"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveExperienceUpCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="2" Content="v" Width="28" Margin="2,0,0,0"
                                                                ToolTip.Tip="Move Down"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveExperienceDownCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="3" Content="X" Margin="5,0,0,0"
                                                                ToolTip.Tip="Remove"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveExperienceCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                    <TextBox Watermark="Company" Text="{Binding Company}"/>
                                                    <TextBox Watermark="Location" Text="{Binding Location}"/>
                                                    <Grid ColumnDefinitions="Auto,5,Auto,20,Auto,5,Auto,10,Auto">
                                                        <ComboBox Grid.Column="0" Width="70"
                                                                  ItemsSource="{x:Static vm:DateOptions.Months}"
                                                                  SelectedItem="{Binding StartMonthName}"
                                                                  PlaceholderText="Month"/>
                                                        <ComboBox Grid.Column="2" Width="80"
                                                                  ItemsSource="{x:Static vm:DateOptions.Years}"
                                                                  SelectedItem="{Binding StartYear}"
                                                                  PlaceholderText="Year"/>
                                                        <TextBlock Grid.Column="3" Text="to" VerticalAlignment="Center"/>
                                                        <ComboBox Grid.Column="4" Width="70"
                                                                  ItemsSource="{x:Static vm:DateOptions.Months}"
                                                                  SelectedItem="{Binding EndMonthName}"
                                                                  IsEnabled="{Binding !IsCurrentRole}"
                                                                  PlaceholderText="Month"/>
                                                        <ComboBox Grid.Column="6" Width="80"
                                                                  ItemsSource="{x:Static vm:DateOptions.Years}"
                                                                  SelectedItem="{Binding EndYear}"
                                                                  IsEnabled="{Binding !IsCurrentRole}"
                                                                  PlaceholderText="Year"/>
                                                        <CheckBox Grid.Column="8" Content="Current" IsChecked="{Binding IsCurrentRole}"/>
                                                    </Grid>
                                                    <TextBox Watermark="Description" Text="{Binding Description}"
                                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
                                                    <TextBox Watermark="Achievements (one per line)" Text="{Binding Achievements}"
                                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Education -->
                        <Border Background="{DynamicResource RbSurface1}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Education" FontWeight="SemiBold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="+ Add" Command="{Binding AddEducationCommand}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding EducationList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EducationViewModel">
                                            <Border Background="{DynamicResource RbSurface2}"
                                                    CornerRadius="4" Padding="10" Margin="0,5">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                        <TextBox Grid.Column="0" Watermark="Degree" Text="{Binding Degree}"/>
                                                        <Button Grid.Column="1" Content="^" Width="28" Margin="5,0,0,0"
                                                                ToolTip.Tip="Move Up"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveEducationUpCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="2" Content="v" Width="28" Margin="2,0,0,0"
                                                                ToolTip.Tip="Move Down"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveEducationDownCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="3" Content="X" Margin="5,0,0,0"
                                                                ToolTip.Tip="Remove"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveEducationCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                    <TextBox Watermark="Field of Study" Text="{Binding FieldOfStudy}"/>
                                                    <TextBox Watermark="Institution" Text="{Binding Institution}"/>
                                                    <TextBox Watermark="Location" Text="{Binding Location}"/>
                                                    <Grid ColumnDefinitions="Auto,20,Auto,10,*">
                                                        <ComboBox Grid.Column="0" Width="80"
                                                                  ItemsSource="{x:Static vm:DateOptions.Years}"
                                                                  SelectedItem="{Binding StartYear}"
                                                                  PlaceholderText="Start Year"/>
                                                        <ComboBox Grid.Column="2" Width="80"
                                                                  ItemsSource="{x:Static vm:DateOptions.Years}"
                                                                  SelectedItem="{Binding EndYear}"
                                                                  IsEnabled="{Binding !IsCurrentlyStudying}"
                                                                  PlaceholderText="End Year"/>
                                                        <CheckBox Grid.Column="4" Content="Currently studying"
                                                                  IsChecked="{Binding IsCurrentlyStudying}"/>
                                                    </Grid>
                                                    <TextBox Watermark="Grade/GPA" Text="{Binding Grade}"/>
                                                    <TextBox Watermark="Description" Text="{Binding Description}"
                                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Skills -->
                        <Border Background="{DynamicResource RbSurface1}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Skills" FontWeight="SemiBold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="+ Add" Command="{Binding AddSkillCommand}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Skills}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SkillViewModel">
                                            <Grid ColumnDefinitions="*,10,*,10,Auto,Auto,Auto,Auto" Margin="0,3">
                                                <TextBox Grid.Column="0" Watermark="Skill Name" Text="{Binding Name}"/>
                                                <TextBox Grid.Column="2" Watermark="Category" Text="{Binding Category}"/>
                                                <ComboBox Grid.Column="4" Width="120"
                                                          ToolTip.Tip="Proficiency level"
                                                          ItemsSource="{x:Static vm:SkillViewModel.AvailableLevels}"
                                                          SelectedItem="{Binding Level}"/>
                                                <Button Grid.Column="5" Content="^" Width="28" Margin="5,0,0,0"
                                                        ToolTip.Tip="Move Up"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveSkillUpCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="6" Content="v" Width="28" Margin="2,0,0,0"
                                                        ToolTip.Tip="Move Down"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveSkillDownCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="7" Content="X" Margin="5,0,0,0"
                                                        ToolTip.Tip="Remove"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveSkillCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Languages -->
                        <Border Background="{DynamicResource RbSurface1}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Languages" FontWeight="SemiBold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="+ Add" Command="{Binding AddLanguageCommand}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Languages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LanguageViewModel">
                                            <Grid ColumnDefinitions="*,10,*,Auto,Auto,Auto" Margin="0,3">
                                                <TextBox Grid.Column="0" Watermark="Language" Text="{Binding Name}"/>
                                                <ComboBox Grid.Column="2"
                                                          ItemsSource="{x:Static vm:LanguageViewModel.AvailableProficiencies}"
                                                          SelectedItem="{Binding Proficiency}"
                                                          HorizontalAlignment="Stretch"/>
                                                <Button Grid.Column="3" Content="^" Width="28" Margin="5,0,0,0"
                                                        ToolTip.Tip="Move Up"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveLanguageUpCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="4" Content="v" Width="28" Margin="2,0,0,0"
                                                        ToolTip.Tip="Move Down"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveLanguageDownCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="5" Content="X" Margin="5,0,0,0"
                                                        ToolTip.Tip="Remove"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveLanguageCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Projects -->
                        <Border Background="{DynamicResource RbSurface1}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Projects" FontWeight="SemiBold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="+ Add" Command="{Binding AddProjectCommand}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Projects}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProjectViewModel">
                                            <Border Background="{DynamicResource RbSurface2}"
                                                    CornerRadius="4" Padding="10" Margin="0,5">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                        <TextBox Grid.Column="0" Watermark="Project Name" Text="{Binding Name}"/>
                                                        <Button Grid.Column="1" Content="^" Width="28" Margin="5,0,0,0"
                                                                ToolTip.Tip="Move Up"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveProjectUpCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="2" Content="v" Width="28" Margin="2,0,0,0"
                                                                ToolTip.Tip="Move Down"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveProjectDownCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="3" Content="X" Margin="5,0,0,0"
                                                                ToolTip.Tip="Remove"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveProjectCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                    <TextBox Watermark="Description" Text="{Binding Description}"
                                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
                                                    <TextBox Watermark="Highlights (one per line)" Text="{Binding Highlights}"
                                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
                                                    <TextBox Watermark="Technologies (comma separated)" Text="{Binding Technologies}"/>
                                                    <TextBox Watermark="URL" Text="{Binding Url}"/>
                                                    <Grid ColumnDefinitions="Auto,5,Auto,20,Auto,5,Auto,10,Auto">
                                                        <ComboBox Grid.Column="0" Width="70"
                                                                  ItemsSource="{x:Static vm:DateOptions.Months}"
                                                                  SelectedItem="{Binding StartMonthName}"
                                                                  PlaceholderText="Month"/>
                                                        <ComboBox Grid.Column="2" Width="80"
                                                                  ItemsSource="{x:Static vm:DateOptions.Years}"
                                                                  SelectedItem="{Binding StartYear}"
                                                                  PlaceholderText="Year"/>
                                                        <TextBlock Grid.Column="3" Text="to" VerticalAlignment="Center"/>
                                                        <ComboBox Grid.Column="4" Width="70"
                                                                  ItemsSource="{x:Static vm:DateOptions.Months}"
                                                                  SelectedItem="{Binding EndMonthName}"
                                                                  IsEnabled="{Binding !IsOngoing}"
                                                                  PlaceholderText="Month"/>
                                                        <ComboBox Grid.Column="6" Width="80"
                                                                  ItemsSource="{x:Static vm:DateOptions.Years}"
                                                                  SelectedItem="{Binding EndYear}"
                                                                  IsEnabled="{Binding !IsOngoing}"
                                                                  PlaceholderText="Year"/>
                                                        <CheckBox Grid.Column="8" Content="Ongoing" IsChecked="{Binding IsOngoing}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Certifications -->
                        <Border Background="{DynamicResource RbSurface1}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Certifications" FontWeight="SemiBold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="+ Add" Command="{Binding AddCertificationCommand}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Certifications}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CertificationViewModel">
                                            <Border Background="{DynamicResource RbSurface2}"
                                                    CornerRadius="4" Padding="10" Margin="0,5">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                        <TextBox Grid.Column="0" Watermark="Certification Name" Text="{Binding Name}"/>
                                                        <Button Grid.Column="1" Content="^" Width="28" Margin="5,0,0,0"
                                                                ToolTip.Tip="Move Up"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveCertificationUpCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="2" Content="v" Width="28" Margin="2,0,0,0"
                                                                ToolTip.Tip="Move Down"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveCertificationDownCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="3" Content="X" Margin="5,0,0,0"
                                                                ToolTip.Tip="Remove"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveCertificationCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                    <TextBox Watermark="Issuing Organization" Text="{Binding IssuingOrganization}"/>
                                                    <Grid ColumnDefinitions="Auto,5,Auto,20,Auto,5,Auto,10,Auto">
                                                        <ComboBox Grid.Column="0" Width="70"
                                                                  ToolTip.Tip="Issued"
                                                                  ItemsSource="{x:Static vm:DateOptions.Months}"
                                                                  SelectedItem="{Binding IssueMonthName}"
                                                                  PlaceholderText="Month"/>
                                                        <ComboBox Grid.Column="2" Width="80"
                                                                  ToolTip.Tip="Issued"
                                                                  ItemsSource="{x:Static vm:DateOptions.Years}"
                                                                  SelectedItem="{Binding IssueYear}"
                                                                  PlaceholderText="Year"/>
                                                        <TextBlock Grid.Column="3" Text="to" VerticalAlignment="Center"/>
                                                        <ComboBox Grid.Column="4" Width="70"
                                                                  ToolTip.Tip="Expires"
                                                                  ItemsSource="{x:Static vm:DateOptions.Months}"
                                                                  SelectedItem="{Binding ExpirationMonthName}"
                                                                  IsEnabled="{Binding !DoesNotExpire}"
                                                                  PlaceholderText="Month"/>
                                                        <ComboBox Grid.Column="6" Width="80"
                                                                  ToolTip.Tip="Expires"
                                                                  ItemsSource="{x:Static vm:DateOptions.Years}"
                                                                  SelectedItem="{Binding ExpirationYear}"
                                                                  IsEnabled="{Binding !DoesNotExpire}"
                                                                  PlaceholderText="Year"/>
                                                        <CheckBox Grid.Column="8" Content="No expiry"
                                                                  IsChecked="{Binding DoesNotExpire}"/>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,10,*">
                                                        <TextBox Grid.Column="0" Watermark="Credential ID" Text="{Binding CredentialId}"/>
                                                        <TextBox Grid.Column="2" Watermark="Credential URL" Text="{Binding CredentialUrl}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Custom Sections -->
                        <Border Background="{DynamicResource RbSurface1}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Custom Sections" FontWeight="SemiBold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="+ Add Section" Command="{Binding AddCustomSectionCommand}"/>
                                </Grid>
                                <TextBlock Text="Anything the standard sections do not cover: publications, awards, volunteering..."
                                           FontSize="11" Opacity="0.6"/>
                                <ItemsControl ItemsSource="{Binding CustomSections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CustomSectionViewModel">
                                            <Border Background="{DynamicResource RbSurface2}"
                                                    CornerRadius="4" Padding="10" Margin="0,5">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBox Grid.Column="0" Watermark="Section Title" Text="{Binding Title}"/>
                                                        <Button Grid.Column="1" Content="X" Margin="5,0,0,0"
                                                                ToolTip.Tip="Remove section"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveCustomSectionCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>

                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:CustomSectionItemViewModel">
                                                                <Border Background="{DynamicResource RbSurface1}"
                                                                        CornerRadius="4" Padding="8" Margin="0,4">
                                                                    <StackPanel Spacing="6">
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <TextBox Grid.Column="0" Watermark="Item Title" Text="{Binding Title}"/>
                                                                            <Button Grid.Column="1" Content="X" Margin="5,0,0,0"
                                                                                    ToolTip.Tip="Remove item"
                                                                                    Command="{Binding $parent[ItemsControl].((vm:CustomSectionViewModel)DataContext).RemoveItemCommand}"
                                                                                    CommandParameter="{Binding}"/>
                                                                        </Grid>
                                                                        <TextBox Watermark="Subtitle" Text="{Binding Subtitle}"/>
                                                                        <TextBox Watermark="Description" Text="{Binding Description}"
                                                                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50"/>
                                                                        <Grid ColumnDefinitions="Auto,5,Auto,20,Auto,5,Auto">
                                                                            <ComboBox Grid.Column="0" Width="70"
                                                                                      ItemsSource="{x:Static vm:DateOptions.Months}"
                                                                                      SelectedItem="{Binding StartMonthName}"
                                                                                      PlaceholderText="Month"/>
                                                                            <ComboBox Grid.Column="2" Width="80"
                                                                                      ItemsSource="{x:Static vm:DateOptions.Years}"
                                                                                      SelectedItem="{Binding StartYear}"
                                                                                      PlaceholderText="Year"/>
                                                                            <TextBlock Grid.Column="3" Text="to" VerticalAlignment="Center"/>
                                                                            <ComboBox Grid.Column="4" Width="70"
                                                                                      ItemsSource="{x:Static vm:DateOptions.Months}"
                                                                                      SelectedItem="{Binding EndMonthName}"
                                                                                      PlaceholderText="Month"/>
                                                                            <ComboBox Grid.Column="6" Width="80"
                                                                                      ItemsSource="{x:Static vm:DateOptions.Years}"
                                                                                      SelectedItem="{Binding EndYear}"
                                                                                      PlaceholderText="Year"/>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Button Content="+ Add Item" HorizontalAlignment="Left"
                                                            Command="{Binding AddItemCommand}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Panel - Preview -->
            <Grid Grid.Column="1" Background="{DynamicResource RbSurface2}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Preview Toolbar -->
                <Border Grid.Row="0" Background="{DynamicResource RbSurface2}"
                        Padding="10">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                            <Button Content="-" Command="{Binding ZoomOutCommand}" Width="30"/>
                            <TextBlock Text="{Binding PreviewZoom, StringFormat={}{0:P0}}"
                                       VerticalAlignment="Center" Width="50" TextAlignment="Center"/>
                            <Button Content="+" Command="{Binding ZoomInCommand}" Width="30"/>
                            <Button Content="Reset" Command="{Binding ZoomResetCommand}" Margin="10,0,0,0"/>
                            <Border Width="1" Background="{DynamicResource RbSurface3}"
                                    Margin="10,2"/>
                            <Button Content="Undo" Command="{Binding UndoCommand}"
                                    IsEnabled="{Binding CanUndo}"
                                    ToolTip.Tip="{Binding NextUndoDescription, StringFormat='Undo: {0}'}"/>
                            <Button Content="Redo" Command="{Binding RedoCommand}"
                                    IsEnabled="{Binding CanRedo}"
                                    ToolTip.Tip="{Binding NextRedoDescription, StringFormat='Redo: {0}'}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5">
                            <Button Content="Save" Command="{Binding SaveCurrentResumeCommand}"/>
                            <SplitButton Content="Export PDF" Command="{Binding ExportCommand}" CommandParameter="PDF">
                                <SplitButton.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="PDF" Command="{Binding ExportCommand}" CommandParameter="PDF"/>
                                        <MenuItem Header="Word (DOCX)" Command="{Binding ExportCommand}" CommandParameter="DOCX"/>
                                        <MenuItem Header="HTML" Command="{Binding ExportCommand}" CommandParameter="HTML"/>
                                        <MenuItem Header="PNG Image" Command="{Binding ExportCommand}" CommandParameter="PNG"/>
                                        <MenuItem Header="JSON (Backup)" Command="{Binding ExportCommand}" CommandParameter="JSON"/>
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Preview Content -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PreviewPages}" HorizontalAlignment="Center">
                        <ItemsControl.RenderTransform>
                            <ScaleTransform ScaleX="{Binding PreviewZoom}" ScaleY="{Binding PreviewZoom}"/>
                        </ItemsControl.RenderTransform>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="20,10" Background="White" BoxShadow="0 4 20 0 #40000000">
                                    <Image Source="{Binding}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource RbSurface2}"
                Padding="10,5">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12"/>
                <!-- Update prompt. Collapsed entirely unless an update is genuinely available,
                     so nothing shows when running from source or the portable build. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsUpdateAvailable}">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{DynamicResource RbSuccess}"/>
                    <TextBlock Text="{Binding UpdateStatusText}" FontSize="12" VerticalAlignment="Center"/>
                    <Button Content="Restart &amp; update" FontSize="11" Padding="8,2"
                            Command="{Binding ApplyUpdateCommand}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="10,0">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="#f59e0b" IsVisible="{Binding IsDirty}"/>
                    <TextBlock Text="{Binding SaveStateText}" FontSize="12" Opacity="0.8"/>
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding SelectedTemplate.Name, StringFormat='Template: {0}'}"
                           FontSize="12" Opacity="0.7"/>
            </Grid>
        </Border>

        <!-- Template Gallery Overlay -->
        <Border Grid.RowSpan="3" Background="#80000000" IsVisible="{Binding ShowTemplateGallery}">
            <Border Background="{DynamicResource RbSurface1}"
                    CornerRadius="12" Margin="50" Padding="20">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" Text="Choose a Template" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Templates}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="10" Padding="15" MinWidth="200"
                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SelectTemplateCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                       FontSize="11" Opacity="0.7" MaxWidth="180"/>
                                            <TextBlock Text="{Binding Category}" FontSize="10"
                                                       Foreground="{DynamicResource RbAccent}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="Cancel" HorizontalAlignment="Right" Margin="0,20,0,0"
                            Click="CloseTemplateGallery_Click"/>
                </Grid>
            </Border>
        </Border>

        <!-- Resume List Overlay -->
        <Border Grid.RowSpan="3" Background="#80000000" IsVisible="{Binding ShowResumeList}">
            <Border Background="{DynamicResource RbSurface1}"
                    CornerRadius="12" Margin="100" Padding="20" MaxWidth="600">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" Text="Your Resumes" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding SavedResumes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Resume">
                                    <Border Background="{DynamicResource RbSurface2}"
                                            CornerRadius="8" Padding="15"
                                            Margin="{Binding IsVariant, Converter={x:Static vm:MainWindowViewModel.VariantIndentConverter}}"
                                            BorderBrush="{DynamicResource RbAccent}"
                                            BorderThickness="{Binding IsVariant, Converter={x:Static vm:MainWindowViewModel.VariantBorderConverter}}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border Background="#332563eb" CornerRadius="8" Padding="6,1"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding IsVariant}">
                                                        <TextBlock Text="Variant" FontSize="10"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding TargetRole, StringFormat='Tailored for: {0}'}"
                                                           FontSize="11" Opacity="0.8"
                                                           IsVisible="{Binding TargetRole, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                <TextBlock Text="{Binding PersonalInfo.FullName}" FontSize="12" Opacity="0.7"/>
                                                <TextBlock Text="{Binding UpdatedAt, StringFormat='Last updated: {0:g}'}"
                                                           FontSize="11" Opacity="0.5"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                                <Button Content="Open"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).LoadResumeCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Duplicate"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DuplicateResumeCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Delete"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DeleteResumeCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" Spacing="10">
                        <Button Content="New Resume" Command="{Binding CreateNewResumeCommand}"/>
                        <Button Content="Cancel" Command="{Binding CloseResumeListCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Cover Letter Editor Overlay -->
        <Border Grid.RowSpan="3" Background="#80000000" IsVisible="{Binding ShowCoverLetterEditor}">
            <Border Background="{DynamicResource RbSurface1}"
                    CornerRadius="12" Margin="40" Padding="20">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Cover Letter" FontSize="24" FontWeight="Bold"/>
                            <TextBlock Text="{Binding LetterSaveStateText}" FontSize="12" Opacity="0.7"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                            <Button Content="Draft with AI"
                                    Command="{Binding DraftCoverLetterWithAiCommand}"
                                    IsEnabled="{Binding !IsDraftingLetter}"
                                    ToolTip.Tip="Works without an API key: falls back to a draft built from your resume"/>
                            <Button Content="Save" Command="{Binding SaveCoverLetterCommand}"/>
                            <SplitButton Content="Export PDF"
                                         Command="{Binding ExportCoverLetterCommand}" CommandParameter="PDF">
                                <SplitButton.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="PDF" Command="{Binding ExportCoverLetterCommand}" CommandParameter="PDF"/>
                                        <MenuItem Header="Word (DOCX)" Command="{Binding ExportCoverLetterCommand}" CommandParameter="DOCX"/>
                                        <MenuItem Header="Plain Text" Command="{Binding ExportCoverLetterCommand}" CommandParameter="TEXT"/>
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>
                            <Button Content="Close" Command="{Binding CloseCoverLetterEditorCommand}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="420,*">
                        <!-- Letter Editor -->
                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto" Margin="0,0,15,0">
                            <StackPanel Spacing="10">
                                <ProgressBar IsIndeterminate="True" Height="4"
                                             IsVisible="{Binding IsDraftingLetter}"/>

                                <TextBox Watermark="Letter name" Text="{Binding LetterName}"/>

                                <TextBlock Text="Recipient" FontWeight="SemiBold" FontSize="12" Margin="0,5,0,0"/>
                                <Grid ColumnDefinitions="*,10,*">
                                    <TextBox Grid.Column="0" Watermark="Recipient name"
                                             Text="{Binding LetterRecipientName}"/>
                                    <TextBox Grid.Column="2" Watermark="Recipient title"
                                             Text="{Binding LetterRecipientTitle}"/>
                                </Grid>
                                <TextBox Watermark="Company" Text="{Binding LetterCompanyName}"/>
                                <TextBox Watermark="Company address"
                                         Text="{Binding LetterCompanyAddress}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50"/>

                                <TextBlock Text="Letter" FontWeight="SemiBold" FontSize="12" Margin="0,5,0,0"/>
                                <DatePicker SelectedDate="{Binding LetterDate}" HorizontalAlignment="Stretch"/>
                                <TextBox Watermark="Subject" Text="{Binding LetterSubject}"/>
                                <TextBox Watermark="{Binding LetterSalutationPlaceholder}"
                                         Text="{Binding LetterSalutation}"
                                         ToolTip.Tip="Leave empty to use the fallback shown here"/>

                                <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                                    <TextBlock Text="Body Paragraphs" FontWeight="SemiBold" FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="+ Add"
                                            Command="{Binding AddLetterParagraphCommand}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding LetterParagraphs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LetterParagraphViewModel">
                                            <Border Background="{DynamicResource RbSurface2}"
                                                    CornerRadius="4" Padding="8" Margin="0,3">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBox Grid.Column="0" Text="{Binding Text}"
                                                             AcceptsReturn="True" TextWrapping="Wrap"
                                                             MinHeight="70"
                                                             Watermark="Paragraph text..."/>
                                                    <StackPanel Grid.Column="1" Spacing="2" Margin="5,0,0,0">
                                                        <Button Content="^" Width="28" Height="28" Padding="0"
                                                                ToolTip.Tip="Move Up"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveLetterParagraphUpCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="v" Width="28" Height="28" Padding="0"
                                                                ToolTip.Tip="Move Down"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveLetterParagraphDownCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="X" Width="28" Height="28" Padding="0"
                                                                ToolTip.Tip="Remove"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveLetterParagraphCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBox Watermark="Closing (e.g. Sincerely,)" Text="{Binding LetterClosing}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Letter Preview -->
                        <Border Grid.Column="1" Background="{DynamicResource RbSurface2}"
                                CornerRadius="8">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding LetterPreviewPages}" HorizontalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="20,10" Background="White" BoxShadow="0 4 20 0 #40000000">
                                                <Image Source="{Binding}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="2" Margin="0,15,0,0" FontSize="11" Opacity="0.6"
                               Text="The letter inherits the sender block and styling of the resume it was created from."/>
                </Grid>
            </Border>
        </Border>

        <!-- Cover Letter List Overlay -->
        <Border Grid.RowSpan="3" Background="#80000000" IsVisible="{Binding ShowCoverLetterList}">
            <Border Background="{DynamicResource RbSurface1}"
                    CornerRadius="12" Margin="100" Padding="20" MaxWidth="600">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" Text="Your Cover Letters" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                    <ScrollViewer Grid.Row="1">
                        <StackPanel>
                            <TextBlock Text="No cover letters yet - create one from the current resume."
                                       FontSize="12" Opacity="0.6"
                                       IsVisible="{Binding !CoverLetters.Count}"/>
                            <ItemsControl ItemsSource="{Binding CoverLetters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:CoverLetter">
                                        <Border Background="{DynamicResource RbSurface2}"
                                                CornerRadius="8" Padding="15" Margin="0,5">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="3">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding CompanyName}" FontSize="12" Opacity="0.7"
                                                               IsVisible="{Binding CompanyName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    <TextBlock Text="{Binding UpdatedAt, StringFormat='Last updated: {0:g}'}"
                                                               FontSize="11" Opacity="0.5"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                                    <Button Content="Open"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).LoadCoverLetterCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Delete"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DeleteCoverLetterCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" Spacing="10">
                        <Button Content="New Cover Letter" Command="{Binding NewCoverLetterCommand}"/>
                        <Button Content="Cancel" Command="{Binding CloseCoverLetterListCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="3" Background="#80000000" IsVisible="{Binding IsLoading}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200"/>
                <TextBlock Text="Exporting..." Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
