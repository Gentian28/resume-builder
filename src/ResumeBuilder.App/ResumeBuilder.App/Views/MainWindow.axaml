<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ResumeBuilder.App.ViewModels"
        xmlns:conv="using:ResumeBuilder.App.Converters"
        xmlns:views="using:ResumeBuilder.App.Views"
        xmlns:models="using:ResumeBuilder.Core.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="ResumeBuilder.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Resume Builder"
        Icon="/Assets/icon.ico"
        Width="1400" Height="900"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCurrentResumeCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportCommand}" CommandParameter="PDF"/>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenResumeListCommand}"/>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding CreateNewResumeCommand}"/>
        <KeyBinding Gesture="Ctrl+T" Command="{Binding ToggleThemeCommand}"/>
    </Window.KeyBindings>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Menu Bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_New Resume" Command="{Binding CreateNewResumeCommand}" InputGesture="Ctrl+N"/>
                <MenuItem Header="_Open..." Command="{Binding OpenResumeListCommand}" InputGesture="Ctrl+O"/>
                <MenuItem Header="_Save" Command="{Binding SaveCurrentResumeCommand}" InputGesture="Ctrl+S"/>
                <!-- "Duplicate", not "Save As": it clones inside the app. The Word phrase promises
                     a choose-a-location dialog this command has never shown. Files come from Export. -->
                <MenuItem Header="_Duplicate..." Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="New _Cover Letter" Command="{Binding NewCoverLetterCommand}"/>
                <MenuItem Header="Cover _Letters..." Command="{Binding OpenCoverLetterListCommand}"/>
                <Separator/>
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}"
                          InputGesture="Ctrl+Z"
                          IsEnabled="{Binding CanUndo}">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Undo"/>
                            <TextBlock Text="{Binding NextUndoDescription, StringFormat=' ({0})'}"
                                       IsVisible="{Binding NextUndoDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Opacity="0.6"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}"
                          InputGesture="Ctrl+Y"
                          IsEnabled="{Binding CanRedo}">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Redo"/>
                            <TextBlock Text="{Binding NextRedoDescription, StringFormat=' ({0})'}"
                                       IsVisible="{Binding NextRedoDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Opacity="0.6"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Import">
                    <MenuItem Header="JSON Resume (.json)" Command="{Binding ImportJsonResumeCommand}"/>
                    <MenuItem Header="LinkedIn Export (.zip)" Command="{Binding ImportLinkedInCommand}"/>
                    <MenuItem Header="PDF Resume (.pdf)" Command="{Binding ImportPdfCommand}"/>
                </MenuItem>
                <MenuItem Header="_Export as PDF..." Command="{Binding ExportCommand}" CommandParameter="PDF" InputGesture="Ctrl+E"/>
                <MenuItem Header="Export">
                    <MenuItem Header="PDF" Command="{Binding ExportCommand}" CommandParameter="PDF"/>
                    <MenuItem Header="Word (DOCX)" Command="{Binding ExportCommand}" CommandParameter="DOCX"/>
                    <MenuItem Header="HTML" Command="{Binding ExportCommand}" CommandParameter="HTML"/>
                    <MenuItem Header="PNG Image" Command="{Binding ExportCommand}" CommandParameter="PNG"/>
                    <Separator/>
                    <MenuItem Header="JSON Resume (Standard)" Command="{Binding ExportCommand}" CommandParameter="JSONRESUME"/>
                    <MenuItem Header="JSON (App Backup)" Command="{Binding ExportCommand}" CommandParameter="JSON"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Templates">
                <MenuItem Header="Choose Template..." Command="{Binding OpenTemplateGalleryCommand}"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Spell Check">
                    <MenuItem Header="Toggle Spell Check" Command="{Binding ToggleSpellCheckCommand}"/>
                    <MenuItem Header="Check Summary..." Command="{Binding ShowSpellingSuggestionsCommand}"/>
                </MenuItem>
                <MenuItem Header="AI Assistant">
                    <MenuItem Header="Show AI Panel" Command="{Binding ToggleAiPanelCommand}"/>
                    <Separator/>
                    <MenuItem Header="Generate Summary" Command="{Binding GenerateAiSummaryCommand}"
                              IsEnabled="{Binding IsAiConfigured}"/>
                    <MenuItem Header="Suggest Skills" Command="{Binding SuggestAiSkillsCommand}"
                              IsEnabled="{Binding IsAiConfigured}"/>
                </MenuItem>
                <MenuItem Header="Tailor to Job">
                    <MenuItem Header="Show Tailor Panel" Command="{Binding ToggleTailorPanelCommand}"/>
                    <MenuItem Header="Tailor to Job" Command="{Binding TailorToJobCommand}"/>
                    <MenuItem Header="Apply Accepted Rewrites" Command="{Binding ApplyAcceptedEditsCommand}"/>
                    <MenuItem Header="Save as Variant for This Job" Command="{Binding SaveAsVariantCommand}"/>
                    <MenuItem Header="Clear Analysis" Command="{Binding ClearTailoringCommand}"/>
                </MenuItem>
                <MenuItem Header="Sync">
                    <MenuItem Header="Show Sync Panel" Command="{Binding ToggleSyncPanelCommand}"/>
                    <Separator/>
                    <MenuItem Header="Sync All Resumes" Command="{Binding SyncAllCommand}"
                              IsEnabled="{Binding IsSyncConfigured}"/>
                    <MenuItem Header="Sync Current Resume" Command="{Binding SyncCurrentResumeCommand}"
                              IsEnabled="{Binding IsSyncConfigured}"/>
                    <MenuItem Header="Refresh Remote List" Command="{Binding RefreshRemoteResumesCommand}"
                              IsEnabled="{Binding IsSyncConfigured}"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom In" Command="{Binding ZoomInCommand}"/>
                <MenuItem Header="Zoom Out" Command="{Binding ZoomOutCommand}"/>
                <MenuItem Header="Reset Zoom" Command="{Binding ZoomResetCommand}"/>
                <Separator/>
                <MenuItem Header="Theme">
                    <MenuItem Header="Toggle Light/Dark" Command="{Binding ToggleThemeCommand}"
                              InputGesture="Ctrl+T"/>
                    <Separator/>
                    <MenuItem Header="Light" Command="{Binding SetLightThemeCommand}"/>
                    <MenuItem Header="Dark" Command="{Binding SetDarkThemeCommand}"/>
                    <MenuItem Header="System" Command="{Binding SetSystemThemeCommand}"/>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Main Content -->
        <!-- Command bar. The features that distinguish this product used to be three levels deep
             under File and Tools; the menu bar stays for completeness but is no longer the only
             route to them. Zoom/undo/save/export move here from the old preview toolbar, which
             put them ~2800px from Export on a wide window. -->
        <Border Grid.Row="1" Background="{DynamicResource RbSurface1}"
                BorderBrush="{DynamicResource RbBorder}" BorderThickness="0,0,0,1"
                Padding="11,7">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <Button Grid.Column="0" Padding="6,3" Command="{Binding OpenTemplateGalleryCommand}"
                        ToolTip.Tip="Choose a template">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Border Width="15" Height="21" CornerRadius="2" Background="White"
                                ClipToBounds="True">
                            <Image Source="{Binding SelectedTemplateThumbnail}" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="{Binding SelectedTemplate.Name}" FontSize="12"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="▾" FontSize="9" Opacity="0.55" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Content="Tailor to Job" Padding="9,4" Margin="5,0,0,0"
                        Command="{Binding ToggleTailorPanelCommand}"/>

                <Button Grid.Column="2" Content="Applications" Padding="9,4" Margin="4,0,0,0"
                        ToolTip.Tip="Which résumé went where, and what happened"
                        Command="{Binding OpenApplicationsCommand}"/>

                <Button Grid.Column="3" Padding="9,4" Margin="4,0,0,0" Command="{Binding ToggleAiPanelCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="AI Assistant" VerticalAlignment="Center"/>
                        <!-- Status dot, never a disabled button: AI features degrade rather than
                             gate, and a greyed-out control reads as broken instead of offline. -->
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{Binding IsAiLocal, Converter={x:Static conv:AiStatusBrushConverter.Instance}}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="4" Content="Import ▾" Padding="9,4" Margin="4,0,0,0">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="JSON Resume (.json)" Command="{Binding ImportJsonResumeCommand}"/>
                            <MenuItem Header="LinkedIn Export (.zip)" Command="{Binding ImportLinkedInCommand}"/>
                            <MenuItem Header="PDF Resume (.pdf)" Command="{Binding ImportPdfCommand}"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Content="−" Command="{Binding ZoomOutCommand}" Width="28" Padding="0"/>
                    <TextBlock Text="{Binding PreviewZoom, StringFormat={}{0:P0}}" Width="46"
                               TextAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                    <Button Content="+" Command="{Binding ZoomInCommand}" Width="28" Padding="0"/>
                    <Button Content="Reset" Command="{Binding ZoomResetCommand}" Padding="8,3"/>
                </StackPanel>

                <Border Grid.Column="7" Width="1" Margin="9,3"
                        Background="{DynamicResource RbBorder}"/>

                <Button Grid.Column="8" Content="Undo" Command="{Binding UndoCommand}"
                        IsEnabled="{Binding CanUndo}" Padding="9,4"
                        ToolTip.Tip="{Binding NextUndoDescription, StringFormat='Undo: {0}'}"/>
                <Button Grid.Column="9" Content="Redo" Command="{Binding RedoCommand}"
                        IsEnabled="{Binding CanRedo}" Padding="9,4" Margin="4,0,0,0"
                        ToolTip.Tip="{Binding NextRedoDescription, StringFormat='Redo: {0}'}"/>

                <Border Grid.Column="10" Width="1" Margin="9,3"
                        Background="{DynamicResource RbBorder}"/>

                <Button Grid.Column="11" Content="Save" Command="{Binding SaveCurrentResumeCommand}"
                        Padding="11,4"/>
                <SplitButton Grid.Column="12" Content="Export PDF" Margin="5,0,0,0"
                             Classes="accent"
                             Command="{Binding ExportCommand}" CommandParameter="PDF">
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="PDF" Command="{Binding ExportCommand}" CommandParameter="PDF"/>
                            <MenuItem Header="Word (DOCX)" Command="{Binding ExportCommand}" CommandParameter="DOCX"/>
                            <MenuItem Header="HTML" Command="{Binding ExportCommand}" CommandParameter="HTML"/>
                            <MenuItem Header="PNG Image" Command="{Binding ExportCommand}" CommandParameter="PNG"/>
                            <MenuItem Header="Plain text (ATS)" Command="{Binding ExportCommand}" CommandParameter="TXT"/>
                            <MenuItem Header="JSON (Backup)" Command="{Binding ExportCommand}" CommandParameter="JSON"/>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
            </Grid>
        </Border>

        <!-- Three zones: fixed section list, then editor and preview that both flex. Previously a
             fixed 450px rail beside the preview, so widening the window only ever added grey. -->
        <!-- The preview gets the larger weight: a page has a fixed aspect ratio and benefits more
             from width than a column of form fields does. -->
        <Grid Grid.Row="2" ColumnDefinitions="196,1*,1.15*">

            <!-- Zone 1: section navigation -->
            <Border Grid.Column="0" Background="{DynamicResource RbSurface1}"
                    BorderBrush="{DynamicResource RbBorder}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,11">
                        <TextBlock Text="CONTENT" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource RbText3}" Margin="9,4,0,6"/>
                        <ItemsControl ItemsSource="{Binding EditorSections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EditorSection">
                                    <Button Classes="navitem" Classes.on="{Binding IsSelected}"
                                            IsVisible="{Binding !IsDocumentSetting}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="9,6" Margin="0,0,0,1"
                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SelectEditorSectionCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Name}" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="11"
                                                       Foreground="{DynamicResource RbText3}"
                                                       IsVisible="{Binding Count, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="DOCUMENT" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource RbText3}" Margin="9,16,0,6"/>
                        <ItemsControl ItemsSource="{Binding EditorSections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EditorSection">
                                    <Button Classes="navitem" Classes.on="{Binding IsSelected}"
                                            IsVisible="{Binding IsDocumentSetting}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="9,6" Margin="0,0,0,1"
                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SelectEditorSectionCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Name}" FontSize="12"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Zone 2: editor -->
            <views:EditorView Grid.Column="1"/>

            <!-- Right Panel - Preview -->
            <!-- Zone 3: preview -->
            <Grid Grid.Column="2" Background="{DynamicResource RbSurface2}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- The toolbar that used to sit here moved into the window-wide command bar:
                     it put zoom and undo at the far left and Export at the far right, ~2800px
                     apart on a wide window. Row 0 is kept so the preview stays in row 1. -->
                <Border Grid.Row="0" Height="0"/>

                <!-- Preview Content -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PreviewPages}" HorizontalAlignment="Center">
                        <ItemsControl.RenderTransform>
                            <ScaleTransform ScaleX="{Binding PreviewZoom}" ScaleY="{Binding PreviewZoom}"/>
                        </ItemsControl.RenderTransform>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="20,10" Background="White" BoxShadow="0 4 20 0 #40000000">
                                    <Image Source="{Binding}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{DynamicResource RbSurface2}"
                Padding="10,5">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12"/>
                <!-- Update prompt. Collapsed entirely unless an update is genuinely available,
                     so nothing shows when running from source or the portable build. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsUpdateAvailable}">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{DynamicResource RbSuccess}"/>
                    <TextBlock Text="{Binding UpdateStatusText}" FontSize="12" VerticalAlignment="Center"/>
                    <Button Content="Restart &amp; update" FontSize="11" Padding="8,2"
                            Command="{Binding ApplyUpdateCommand}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="10,0">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="#f59e0b" IsVisible="{Binding IsDirty}"/>
                    <TextBlock Text="{Binding SaveStateText}" FontSize="12" Opacity="0.8"/>
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding SelectedTemplate.Name, StringFormat='Template: {0}'}"
                           FontSize="12" Opacity="0.7"/>
            </Grid>
        </Border>

        <!-- Template Gallery Overlay -->
        <!-- Covers rows 1-3 rather than all four, so the menu bar stays reachable: someone who
             wants File > Open on first run should not have to dismiss this to get there. -->
        <views:FirstRunOverlay Grid.Row="1" Grid.RowSpan="3" IsVisible="{Binding ShowFirstRun}"/>

        <views:ApplicationsOverlay Grid.Row="1" Grid.RowSpan="3" IsVisible="{Binding ShowApplications}"/>

        <views:TemplateGalleryOverlay Grid.RowSpan="4" IsVisible="{Binding ShowTemplateGallery}"/>
        <!-- Resume List Overlay -->
        <views:ResumeListOverlay Grid.RowSpan="4" IsVisible="{Binding ShowResumeList}"/>
        <!-- Cover Letter Editor Overlay -->
        <views:CoverLetterEditorOverlay Grid.RowSpan="4" IsVisible="{Binding ShowCoverLetterEditor}"/>
        <!-- Cover Letter List Overlay -->
        <views:CoverLetterListOverlay Grid.RowSpan="4" IsVisible="{Binding ShowCoverLetterList}"/>
        <!-- Loading Overlay -->
        <views:LoadingOverlay Grid.RowSpan="4" IsVisible="{Binding IsLoading}"/>

        <!-- Export toast: keeps the exported file one click away, browser-download style.
             Declared last so it sits above every overlay. -->
        <Border Grid.RowSpan="4" IsVisible="{Binding ShowExportToast}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,44"
                Background="{DynamicResource RbSurface2}"
                BorderBrush="{DynamicResource RbBorder}" BorderThickness="1"
                CornerRadius="8" Padding="14,10"
                BoxShadow="0 4 16 0 #40000000">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center">
                    <Run Text="Exported"/>
                    <Run Text="{Binding ExportToastFileName}" FontWeight="SemiBold"/>
                </TextBlock>
                <Button Content="Open" Classes="accent" Padding="10,4"
                        Command="{Binding OpenExportedFileCommand}"/>
                <Button Content="Show in folder" Padding="10,4"
                        Command="{Binding ShowExportedInFolderCommand}"/>
                <Button Classes="icon"
                        Command="{Binding DismissExportToastCommand}"><PathIcon Data="{StaticResource IconClose}"/></Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
