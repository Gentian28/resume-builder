<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ResumeBuilder.App.ViewModels"
             xmlns:conv="using:ResumeBuilder.App.Converters"
             xmlns:models="using:ResumeBuilder.Core.Models"
             x:Class="ResumeBuilder.App.Views.Sections.SkillsSection"
             x:DataType="vm:MainWindowViewModel">

                        <Border Background="{DynamicResource RbSurface1}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Skills" FontWeight="SemiBold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="+ Add" Command="{Binding AddSkillCommand}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Skills}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SkillViewModel">
                                            <Grid ColumnDefinitions="*,10,*,10,Auto,Auto,Auto,Auto" Margin="0,3">
                                                <StackPanel Grid.Column="0" Spacing="3">
                                                    <TextBlock Classes="fieldlabel" Text="Skill Name"/>
                                                    <TextBox Text="{Binding Name}" AutomationProperties.Name="Skill Name"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="3">
                                                    <TextBlock Classes="fieldlabel" Text="Category"/>
                                                    <TextBox Text="{Binding Category}" AutomationProperties.Name="Category"/>
                                                </StackPanel>
                                                <ComboBox Grid.Column="4" Width="120" VerticalAlignment="Bottom"
                                                          ToolTip.Tip="Proficiency level"
                                                          ItemsSource="{x:Static vm:SkillViewModel.AvailableLevels}"
                                                          SelectedItem="{Binding Level}"/>
                                                <Button Grid.Column="5" Content="↑" Width="28" Margin="5,0,0,0" VerticalAlignment="Bottom"
                                                        ToolTip.Tip="Move Up"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveSkillUpCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="6" Content="↓" Width="28" Margin="2,0,0,0" VerticalAlignment="Bottom"
                                                        ToolTip.Tip="Move Down"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveSkillDownCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="7" Content="×" Margin="5,0,0,0" VerticalAlignment="Bottom"
                                                        ToolTip.Tip="Remove"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveSkillCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

</UserControl>
