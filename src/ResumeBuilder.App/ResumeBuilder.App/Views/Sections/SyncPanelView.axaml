<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ResumeBuilder.App.ViewModels"
             xmlns:conv="using:ResumeBuilder.App.Converters"
             xmlns:models="using:ResumeBuilder.Core.Models"
             x:Class="ResumeBuilder.App.Views.Sections.SyncPanelView"
             x:DataType="vm:MainWindowViewModel">

                        <Border Background="{DynamicResource RbSurface1}"
                                CornerRadius="8" Padding="15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Sync Settings" FontWeight="SemiBold" FontSize="14"/>
                                    <Button Grid.Column="1" Content="X" Padding="4,0"
                                            Command="{Binding ToggleSyncPanelCommand}"/>
                                </Grid>

                                <TextBlock Text="Two-way sync with a local folder (which can itself be a cloud-synced folder like Dropbox, OneDrive, or Google Drive). Newer changes are copied in both directions."
                                           FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>

                                <!-- Configuration -->
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Sync Folder:" FontSize="12"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Text="{Binding SyncFolderPath}"
                                                 Watermark="C:\Users\...\ResumeBackups" AutomationProperties.Name="C:\Users\...\ResumeBackups"/>
                                        <Button Grid.Column="1" Content="Browse..."
                                                Command="{Binding BrowseSyncFolderCommand}"
                                                Margin="5,0,0,0"/>
                                    </Grid>
                                    <TextBlock Text="When both sides changed:" FontSize="12" Margin="0,5,0,0"/>
                                    <ComboBox ItemsSource="{Binding ConflictResolutions}"
                                              SelectedItem="{Binding SelectedConflictResolution}"
                                              HorizontalAlignment="Stretch"/>
                                    <Button Content="Configure Sync"
                                            Command="{Binding ConfigureSyncCommand}"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>

                                <!-- Status -->
                                <Border Background="{DynamicResource RbSurface2}"
                                        CornerRadius="4" Padding="10">
                                    <StackPanel Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Status:" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SyncStatusText}"
                                                       Opacity="0.8" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" IsVisible="{Binding HasSyncResult}">
                                            <TextBlock Text="{Binding SyncUploadedCount, StringFormat='Uploaded: {0}'}"
                                                       FontSize="11" Opacity="0.8"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SyncDownloadedCount, StringFormat='Downloaded: {0}'}"
                                                       FontSize="11" Opacity="0.8"/>
                                        </Grid>
                                        <ProgressBar IsIndeterminate="True"
                                                     IsVisible="{Binding IsSyncing}"
                                                     Height="4"/>
                                    </StackPanel>
                                </Border>

                                <!-- Conflicts -->
                                <Border Background="#33FFA500" CornerRadius="4" Padding="10"
                                        IsVisible="{Binding SyncConflicts.Count}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Conflicts" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="These resumes changed on both sides. The losing version was kept next to the winner as a .conflict.json file in the sync folder."
                                                   FontSize="11" Opacity="0.8" TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{Binding SyncConflicts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SyncConflictViewModel">
                                                    <StackPanel Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding ResumeName}" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.7"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Sync Actions (when configured) -->
                                <StackPanel Spacing="10" IsVisible="{Binding IsSyncConfigured}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Button Content="Sync All"
                                                Command="{Binding SyncAllCommand}"
                                                IsEnabled="{Binding !IsSyncing}"/>
                                        <Button Content="Sync Current"
                                                Command="{Binding SyncCurrentResumeCommand}"
                                                IsEnabled="{Binding !IsSyncing}"/>
                                        <Button Content="Refresh"
                                                Command="{Binding RefreshRemoteResumesCommand}"
                                                IsEnabled="{Binding !IsSyncing}"/>
                                    </StackPanel>

                                    <!-- Remote Files -->
                                    <Expander Header="Remote Resumes" IsExpanded="True">
                                        <StackPanel Spacing="4" Margin="0,5,0,0">
                                            <TextBlock Text="Click to import a remote resume:"
                                                       FontSize="11" Opacity="0.7"
                                                       IsVisible="{Binding RemoteResumes.Count}"/>
                                            <TextBlock Text="No resumes found in sync folder"
                                                       FontSize="11" Opacity="0.5"
                                                       IsVisible="{Binding !RemoteResumes.Count}"/>
                                            <ItemsControl ItemsSource="{Binding RemoteResumes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Margin="0,2" Padding="8,6"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Left"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ImportRemoteResumeCommand}"
                                                                CommandParameter="{Binding Path}">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="12"/>
                                                                    <TextBlock Text="{Binding LastModifiedDisplay}"
                                                                               FontSize="10" Opacity="0.6"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding SizeDisplay}"
                                                                           FontSize="10" Opacity="0.6"
                                                                           VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </StackPanel>
                        </Border>

</UserControl>
